---
<div class="pavilion-container">
  <header class="pavilion-header">
    <div class="header-left">
      <p class="kicker reveal-text">
        <span class="hud-pill neon"><Mic class="icon-tiny" /> THE STORY</span>
      </p>
      <h2 class="pavilion-title reveal-text">CRICKET WITH SOUL.</h2>
      <p class="pavilion-subtitle reveal-text">
        From recording videos in my room to accredited field access at DPL 2026.
      </p>
    </div>
  </header>

  <div class="pavilion-layout">
    <!-- Left Column: Story & Career Innings -->
    <div class="story-column">
      <div class="editorial-card story-body">
        <h3 class="card-heading">The Philosophy</h3>
        <div class="story-text">
          <Story />
        </div>
      </div>

      <!-- Career Innings Timeline -->
      <div class="editorial-card innings-card">
        <h3 class="card-heading">Career Innings</h3>
        <div class="timeline">
          {inningsTimeline.map((item, idx) => (
            <div
              class={`timeline-step ${item.reels ? 'has-reels' : ''}`}
              data-has-reels={item.reels ? 'true' : undefined}
              tabindex={item.reels ? '0' : undefined}
              role={item.reels ? 'button' : undefined}
              aria-expanded={item.reels ? 'false' : undefined}
              aria-label={item.reels ? `${item.title}: View reels highlights.` : undefined}
            >
              <span class="step-num">0{idx + 1}</span>
              <div class="step-content">
                <div class="step-meta">
                  <span class="step-era">{item.dates}</span>
                  <span class={`step-status ${item.accredited ? 'accredited' : 'independent'}`}>
                    {item.accredited ? 'Accredited' : 'Independent Coverage'}
                  </span>
                </div>
                <h4 class="step-title">
                  <span>{item.title}</span>
                  {item.reels && <span class="step-has-reels-dot" title="Has reels highlights" aria-hidden="true"></span>}
                </h4>
                <p class="step-desc">{item.desc}</p>
              </div>

              {item.reels && (
                <div class="innings-popout-window" role="dialog" aria-label={`${item.title} reels window`}>
                  <div class="popout-header">
                    <div class="popout-header-left">
                      <span class="hud-pill neon"><Instagram class="icon-tiny" /> {item.title} REELS</span>
                    </div>
                    <div class="popout-header-right">
                      <button class="popout-close-btn" type="button" aria-label="Close reels window">
                        <X class="icon-tiny" />
                      </button>
                    </div>
                  </div>

                  <div class="popout-carousel-wrapper">
                    <div class="popout-reels-track" role="list">
                      {item.reels.map((r) => (
                        <div class="popout-reel-card tilt-card" role="listitem">
                          <a
                            class="popout-reel-anchor"
                            href={r.url}
                            target="_blank"
                            rel="noopener"
                            aria-label={r.caption || `${item.title} reel`}
                          >
                            <div class="thumb-frame">
                              <Image
                                class="reel-thumb"
                                src={thumb(r.thumb)}
                                alt=""
                                widths={[320, 500]}
                                sizes="(min-width: 64rem) 200px, 50vw"
                              />
                              <div class="frame-vignette"></div>
                              <div class="reel-top-badges">
                                <span class="type-pill reel-pill"><Play class="icon-micro" /> REEL</span>
                              </div>
                              <div class="reel-bottom-info">
                                <div class="metric-chips">
                                  {r.views != null && (
                                    <div class="views-chip">
                                      <Eye class="icon-eye" />
                                      <span>{compactCount(r.views)}</span>
                                    </div>
                                  )}
                                  {r.likes != null && (
                                    <div class="likes-chip">
                                      <Heart class="icon-heart" />
                                      <span>{compactCount(r.likes)}</span>
                                    </div>
                                  )}
                                </div>
                                {r.caption && <p class="caption-text">{r.caption}</p>}
                              </div>
                            </div>
                          </a>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Right Column: Editorial Photo Magazine Spread with 3D Flip Origin Cards -->
    <div class="gallery-column">
      <!-- Feature 1: Live Reporting Mic Photo (Flip reveals Parul University Runner Up Trophy) -->
      <div class="flip-card primary-photo" tabindex="0" role="button" aria-label="Parul University live reporting event. Click or hover to flip for trophy and origin details.">
        <div class="flip-inner">
          <div class="flip-face flip-front">
            <Image 
              src={photoMic} 
              alt="Abhishek Pandey at Parul University PU Wants To Know event" 
              class="photo-img" 
              widths={[500, 900]} 
              sizes="(min-width: 64rem) 420px, 90vw" 
            />
            <div class="photo-badge-chip gold">LIVE REPORTING</div>
          </div>
          <div class="flip-face flip-back polaroid-trophy-back">
            <div class="trophy-image-box">
              <Image
                src={photoTrophy}
                alt="Parul University PU Wants To Know Runner Up Trophy"
                class="trophy-photo"
                widths={[400, 700]}
                sizes="(min-width: 64rem) 420px, 90vw"
              />
              <span class="trophy-plaque-tag">RUNNER UP</span>
            </div>
            <div class="trophy-meta-strip">
              <div class="polaroid-field">
                <span class="polaroid-label"><MapPin class="icon-micro" /> WHERE</span>
                <p class="polaroid-val venue">Parul University, Vadodara</p>
              </div>
              <div class="polaroid-field">
                <span class="polaroid-label"><Sparkles class="icon-micro" /> WHAT</span>
                <p class="polaroid-val what">PU Wants To Know (Live Reporting Competition)</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Feature 2: T20 World Cup Final Desk Landscape Photo -->
      <div class="flip-card landscape-photo" tabindex="0" role="button" aria-label="ICC Men's T20 World Cup Final 2026. Click or hover to flip for origin details.">
        <div class="flip-inner">
          <div class="flip-face flip-front">
            <Image
              src={photoDesk}
              alt="Abhishek Pandey at Narendra Modi Stadium for T20 World Cup Final 2026"
              class="photo-img"
              widths={[500, 900]}
              sizes="(min-width: 64rem) 420px, 90vw"
            />
            <div class="photo-badge-chip gold">T20 WC FINAL 2026</div>
          </div>
          <div class="flip-face flip-back polaroid-back">
            <div class="polaroid-top-row">
              <span class="polaroid-tag gold">WORLD CHAMPIONS</span>
              <span class="polaroid-stamp">FINAL // 2026</span>
            </div>
            <div class="polaroid-fields">
              <div class="polaroid-field">
                <span class="polaroid-label"><MapPin class="icon-micro" /> WHERE</span>
                <p class="polaroid-val venue">Narendra Modi Stadium, Ahmedabad</p>
              </div>
              <div class="polaroid-field-divider"></div>
              <div class="polaroid-field">
                <span class="polaroid-label"><Sparkles class="icon-micro" /> WHAT</span>
                <p class="polaroid-val what">ICC Men's T20 World Cup Final 2026 — India Won the Final</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Dual Sub-Photo Row -->
      <div class="photo-subgrid">
        <!-- Feature 3: Test Match IND vs WI Photo -->
        <div class="flip-card sub-photo" tabindex="0" role="button" aria-label="India vs West Indies Test match 2025. Click or hover to flip for origin details.">
          <div class="flip-inner">
            <div class="flip-face flip-front">
              <Image
                src={photoStands}
                alt="Abhishek Pandey in the stands at Narendra Modi Stadium for India vs West Indies Test match 2025"
                class="photo-img"
                widths={[400, 700]}
                sizes="(min-width: 64rem) 220px, 45vw"
              />
              <div class="photo-badge-chip neon">TEST MATCH</div>
            </div>
            <div class="flip-face flip-back polaroid-back compact">
              <div class="polaroid-top-row">
                <span class="polaroid-tag neon">TEST CRICKET</span>
                <span class="polaroid-stamp">2025</span>
              </div>
              <div class="polaroid-fields">
                <div class="polaroid-field">
                  <span class="polaroid-label"><MapPin class="icon-micro" /> WHERE</span>
                  <p class="polaroid-val venue">Narendra Modi Stadium, Ahmedabad</p>
                </div>
                <div class="polaroid-field-divider"></div>
                <div class="polaroid-field">
                  <span class="polaroid-label"><Sparkles class="icon-micro" /> WHAT</span>
                  <p class="polaroid-val what">India vs West Indies Test Match (2025)</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Feature 4: Arun Jaitley Stadium IPL 2026 GT vs DC Photo -->
        <div class="flip-card sub-photo" tabindex="0" role="button" aria-label="Arun Jaitley Stadium IPL 2026 Gujarat Titans vs DC. Click or hover to flip for origin details.">
          <div class="flip-inner">
            <div class="flip-face flip-front">
              <Image
                src={photoRail}
                alt="Abhishek Pandey at Arun Jaitley Stadium during IPL 2026 GT vs DC fixture"
                class="photo-img"
                widths={[400, 700]}
                sizes="(min-width: 64rem) 220px, 45vw"
              />
              <div class="photo-badge-chip cyan">IPL 2026</div>
            </div>
            <div class="flip-face flip-back polaroid-back compact">
              <div class="polaroid-top-row">
                <span class="polaroid-tag cyan">IPL MATCHDAY</span>
                <span class="polaroid-stamp">2026</span>
              </div>
              <div class="polaroid-fields">
                <div class="polaroid-field">
                  <span class="polaroid-label"><MapPin class="icon-micro" /> WHERE</span>
                  <p class="polaroid-val venue">Arun Jaitley Stadium, New Delhi</p>
                </div>
                <div class="polaroid-field-divider"></div>
                <div class="polaroid-field">
                  <span class="polaroid-label"><Sparkles class="icon-micro" /> WHAT</span>
                  <p class="polaroid-val what">IPL 2026: Gujarat Titans vs DC (GT won by 1 run)</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .pavilion-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-l);
    width: 100%;
    max-width: 86rem;
    margin: 0 auto;
  }

  .pavilion-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    padding-bottom: var(--space-s);
    border-bottom: 1px solid var(--color-line);
  }

  .header-left {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    max-width: 58ch;
  }

  .pavilion-title {
    font-size: clamp(2.5rem, 6vw, 5.5rem);
    color: var(--color-text);
  }

  .pavilion-subtitle {
    margin: 0;
    font-size: var(--step-0);
    color: var(--color-muted);
    line-height: 1.5;
  }

  .pavilion-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-xl);
    align-items: stretch;
    width: 100%;
  }

  @media (min-width: 62rem) {
    .pavilion-layout {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      gap: var(--space-2xl);
    }
  }

  .story-column {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
    position: relative;
    z-index: 10;
  }

  .story-column:has(.timeline-step.is-open),
  .story-column.has-active-popout {
    z-index: 200;
  }

  .editorial-card.innings-card:has(.timeline-step.is-open),
  .editorial-card.innings-card.has-active-popout {
    position: relative;
    z-index: 200;
  }

  .editorial-card {
    background: var(--glass-bg);
    border: var(--glass-border);
    border-top-color: var(--glass-border-top);
    border-left-color: var(--glass-border-left);
    border-bottom-color: var(--glass-border-bottom);
    border-radius: var(--glass-radius);
    padding: clamp(var(--space-m), 4vw, var(--space-l));
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
    box-shadow: var(--glass-highlight), 0 16px 40px -10px rgba(0, 0, 0, 0.65);
  }

  .card-heading {
    font-family: var(--font-display);
    font-size: var(--step-2);
    color: var(--color-neon);
    letter-spacing: 0.02em;
    padding-bottom: var(--space-2xs);
    border-bottom: 1px solid var(--color-line);
  }

  .story-text :global(p) {
    margin: 0 0 var(--space-s);
    font-size: var(--step-0);
    line-height: 1.65;
    color: var(--color-text);
  }

  /* Timeline */
