<script>
  // Mobile touch/click flip toggle for photo cards
  document.querySelectorAll('.flip-card').forEach((card) => {
    card.addEventListener('click', () => {
      card.classList.toggle('is-flipped');
    });
    card.addEventListener('keydown', (e) => {
      if ((e as KeyboardEvent).key === 'Enter' || (e as KeyboardEvent).key === ' ') {
        e.preventDefault();
        card.classList.toggle('is-flipped');
      }
    });
  });

  // Timeline step reels flyout popout: hover preview + click toggle
  const timelineSteps = Array.from(document.querySelectorAll('.timeline-step.has-reels'));
  const controllers: Array<{
    step: Element;
    close: (force?: boolean) => void;
    open: (pinned?: boolean) => void;
    isOpen: () => boolean;
  }> = [];

  timelineSteps.forEach((step) => {
    const popout = step.querySelector('.innings-popout-window');
    const closeBtn = step.querySelector('.popout-close-btn');
    let isPinned = false;
    let isDismissed = false;
    let closeTimer: ReturnType<typeof setTimeout> | null = null;

    function open(pinned = false) {
      if (closeTimer) clearTimeout(closeTimer);
      isDismissed = false;

      // Close all other open popouts
      controllers.forEach((c) => {
        if (c.step !== step) c.close(true);
      });

      step.classList.add('is-open');
      step.closest('.innings-card')?.classList.add('has-active-popout');
      step.closest('.story-column')?.classList.add('has-active-popout');
      step.setAttribute('aria-expanded', 'true');
      if (pinned) isPinned = true;
    }

    function close(force = false) {
      if (isPinned && !force) return;
      isPinned = false;
      if (force) isDismissed = true;
      step.classList.remove('is-open');
      step.setAttribute('aria-expanded', 'false');

      const anyOpen = controllers.some((c) => c.step !== step && c.isOpen());
      if (!anyOpen) {
        step.closest('.innings-card')?.classList.remove('has-active-popout');
        step.closest('.story-column')?.classList.remove('has-active-popout');
      }
    }

    controllers.push({
      step,
      open,
      close,
      isOpen: () => step.classList.contains('is-open')
    });

    step.addEventListener('mouseenter', () => {
      if (!isDismissed) {
        open(isPinned);
      }
    });

    step.addEventListener('mouseleave', () => {
      isDismissed = false;
      if (!isPinned) {
        closeTimer = setTimeout(() => close(false), 260);
      }
    });

    step.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      // Don't toggle if clicking an actual reel link or close button
      if (target.closest('.popout-reel-anchor') || target.closest('.popout-close-btn')) {
        return;
      }
      // If clicking inside carousel track while open, keep open
      if (target.closest('.popout-carousel-wrapper')) {
        return;
      }

      // Clicking the step or title toggles open/pinned state
      if (step.classList.contains('is-open')) {
        close(true);
      } else {
        open(true);
      }
    });

    if (closeBtn) {
      closeBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        close(true);
      });
    }

    step.addEventListener('keydown', (e) => {
      const evt = e as KeyboardEvent;
      if (evt.key === 'Escape') {
        close(true);
      } else if ((evt.key === 'Enter' || evt.key === ' ') && evt.target === step) {
        evt.preventDefault();
        if (step.classList.contains('is-open')) close(true);
        else open(true);
      }
    });
  });

  // Global click outside listener to close any open flyouts
  document.addEventListener('click', (e) => {
    const target = e.target as Node;
    controllers.forEach((c) => {
      if (c.isOpen() && !c.step.contains(target)) {
        c.close(true);
      }
    });
  });
</script>
