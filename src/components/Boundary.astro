---
import { site } from '../data/site.js';
import { Mail, ExternalLink, Sparkles, CheckCircle, ArrowUpRight, Instagram, Youtube, Linkedin } from 'lucide-astro';
import { Image } from 'astro:assets';
import pandaMail from '../assets/photos/panda-mail.webp';

const handle = (url: string) => url.split('/').filter(Boolean).pop()?.replace('@', '') || '';
const socials = [
  ...site.profiles.instagram.map((url) => ({ url, icon: Instagram, handle: `@${handle(url)}` })),
  ...site.profiles.youtube.map((url) => ({ url, icon: Youtube, handle: `@${handle(url)}` })),
  { url: site.profiles.linkedin, icon: Linkedin, handle: 'abhishek-pandey' },
];

---
<div class="boundary-container">
  <div class="marquee-ribbon" aria-hidden="true">
    <div class="marquee-track">
      <div class="marquee-content">
        <span>BRAND SPONSORSHIPS</span>
        <span class="sep">///</span>
        <span class="highlight">LIVE EVENT COVERAGE</span>
        <span class="sep">///</span>
        <span>MEDIA APPEARANCES</span>
        <span class="sep">///</span>
        <span class="highlight">CRICKET ACADEMY COLLABORATIONS</span>
        <span class="sep">///</span>
      </div>
      <div class="marquee-content">
        <span>BRAND SPONSORSHIPS</span>
        <span class="sep">///</span>
        <span class="highlight">LIVE EVENT COVERAGE</span>
        <span class="sep">///</span>
        <span>MEDIA APPEARANCES</span>
        <span class="sep">///</span>
        <span class="highlight">CRICKET ACADEMY COLLABORATIONS</span>
        <span class="sep">///</span>
      </div>
      <div class="marquee-content">
        <span>BRAND SPONSORSHIPS</span>
        <span class="sep">///</span>
        <span class="highlight">LIVE EVENT COVERAGE</span>
        <span class="sep">///</span>
        <span>MEDIA APPEARANCES</span>
        <span class="sep">///</span>
        <span class="highlight">CRICKET ACADEMY COLLABORATIONS</span>
        <span class="sep">///</span>
      </div>
      <div class="marquee-content">
        <span>BRAND SPONSORSHIPS</span>
        <span class="sep">///</span>
        <span class="highlight">LIVE EVENT COVERAGE</span>
        <span class="sep">///</span>
        <span>MEDIA APPEARANCES</span>
        <span class="sep">///</span>
        <span class="highlight">CRICKET ACADEMY COLLABORATIONS</span>
        <span class="sep">///</span>
      </div>
    </div>
  </div>

  <div class="boundary-main">
    <header class="boundary-header">
      <p class="kicker reveal-text">
        <span class="hud-pill neon"><Sparkles class="icon-tiny" /> COLLABORATIONS</span>
      </p>
      <h2 class="massive-headline reveal-text">LET'S BUILD SOMETHING ICONIC.</h2>
      <figure class="boundary-quote">
        <blockquote class="reveal-text">My approach is simple: keep things authentic, respect the audience’s time, and make videos that are both enjoyable and easy to connect with.</blockquote>
        <figcaption>Abhishek Pandey</figcaption>
      </figure>
    </header>

    <div class="action-grid">
      <div class="action-card primary-action">
        <h3 class="action-title">Start a Conversation</h3>
        <p class="action-desc">
          Email a short brief with what you want to promote and when.
        </p>

        <div class="cta-stack">
          <a class="contact-cta cta-email magnetic" href="/go/email" data-cursor-text="EMAIL">
            <Mail class="cta-icon" />
            <span>Email Abhishek</span>
            <ArrowUpRight class="icon-small" />
          </a>
        </div>

        <div class="direct-email-row">
          <span class="lbl">EMAIL:</span>
          <span class="email-val">{site.email}</span>
        </div>

        <div class="signature-wrap" aria-hidden="true">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 360 128"
            class="signature-svg"
            aria-hidden="true"
          >
            <defs>
              <filter id="sig-glow" x="-20%" y="-20%" width="140%" height="140%">
                <feDropShadow dx="0" dy="0" stdDeviation="2.2" flood-color="#E76F51" flood-opacity="0.9" />
                <feDropShadow dx="0" dy="2" stdDeviation="4.5" flood-color="#FFB703" flood-opacity="0.45" />
              </filter>
            </defs>
            <g
              stroke="#E76F51"
              fill="none"
              stroke-width="2.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              filter="url(#sig-glow)"
            >
              <path
                class="sig-name"
                d="M 22 75 C 28 35 42 16 54 18 C 66 20 58 55 46 88 C 38 108 28 98 34 76 C 42 46 64 54 82 58 C 92 60 100 40 104 25 C 108 14 112 16 110 32 C 106 58 98 84 108 82 C 116 80 122 68 126 62 C 132 58 136 38 138 24 C 140 15 144 18 142 34 C 138 58 134 82 134 82 C 134 82 142 56 150 56 C 158 56 156 74 158 82 C 162 76 168 62 170 60 C 172 64 170 76 174 82 C 178 78 184 62 186 58 C 188 54 184 72 188 80 C 190 82 194 72 196 52 C 198 28 202 20 204 26 C 204 36 198 62 198 82 C 198 82 204 56 212 56 C 220 56 218 74 222 82 C 226 78 234 60 236 60 C 238 60 232 72 230 76 C 232 80 238 82 244 80 C 250 76 254 36 256 22 C 258 14 262 18 260 34 C 256 60 252 82 252 82 C 252 82 260 62 266 64 C 270 66 264 74 274 82"
              />
              <path
                class="sig-dot"
                d="M 171 44 C 172 43 174 44 173 46 C 172 47 170 46 171 44 Z"
                stroke-width="3.6"
                fill="#E76F51"
              />
              <path
                class="sig-flourish"
                d="M 274 82 C 290 84 318 80 326 74 C 332 68 316 84 278 94 C 210 112 110 114 42 104 C 30 102 38 98 64 97 C 120 95 200 94 286 91"
                stroke-width="2.4"
              />
            </g>
          </svg>
        </div>

        <div class="panda-mascot-wrap" aria-hidden="true">
          <Image
            src={pandaMail}
            alt="Panda mail mascot"
            class="panda-mascot-img"
            loading="lazy"
            width={240}
            height={283}
          />
        </div>
      </div>

      <div class="action-card registry-card">
        <h3 class="registry-title">Channels</h3>
        <ul class="socials-list" role="list">
          {socials.map((s) => (
            <li>
              <a class="social-row magnetic" href={s.url} target="_blank" rel="noopener" data-cursor-text="VISIT">
                <span class="social-name"><s.icon class="icon-small" /> {s.handle}</span>
                <ExternalLink class="icon-tiny" />
              </a>
            </li>
          ))}
        </ul>

        <div class="accreditation-seal">
          <CheckCircle class="icon-seal" />
          <span>DPL FIELD-OF-PLAY ACCREDITED MEDIA</span>
        </div>
      </div>
    </div>

    <footer class="colophon-bar">
      <div class="colophon-left">
        <span class="brand-wordmark">{site.name}</span>
        <span class="copyright-text">© {new Date().getFullYear()} · All rights reserved</span>
      </div>
    </footer>
  </div>
</div>

<style>
  .boundary-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    width: 100%;
    margin-top: var(--space-xl);
  }

  .boundary-main {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
    max-width: 86rem;
    margin: 0 auto;
    width: 100%;
    padding: 0 var(--space-m);
  }

  .boundary-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    max-width: 65ch;
  }

  .massive-headline {
    font-size: clamp(2.25rem, 6.5vw, 7.5rem);
    line-height: 0.92;
    letter-spacing: -0.02em;
    color: var(--color-text);
    word-break: break-word;
  }

  .boundary-quote {
    margin: 0;
    padding-left: var(--space-m);
    border-left: 3px solid var(--color-neon);
  }

  .boundary-quote blockquote {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--step-1);
    font-style: italic;
    color: var(--color-text);
    line-height: 1.5;
  }

  .boundary-quote figcaption {
    margin-top: var(--space-xs);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  /* Action Grid */
  .action-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-l);
    width: 100%;
  }

  @media (min-width: 58rem) {
    .action-grid {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    }
  }

  .action-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
    padding: clamp(var(--space-m), 4vw, var(--space-xl));
    background: var(--glass-bg);
    border: var(--glass-border);
    border-top-color: var(--glass-border-top);
    border-left-color: var(--glass-border-left);
    border-bottom-color: var(--glass-border-bottom);
    border-radius: var(--glass-radius);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    box-shadow: var(--glass-highlight), 0 16px 40px -10px rgba(0, 0, 0, 0.65);
    transition: border-color 0.3s var(--ease-out), box-shadow 0.3s var(--ease-out), background 0.3s var(--ease-out);
  }

  .primary-action {
    position: relative;
    overflow: hidden;
    border-color: rgba(231, 111, 81, 0.4);
    border-top-color: rgba(255, 140, 120, 0.6);
    box-shadow: var(--glass-highlight-hover), 0 20px 50px rgba(0, 0, 0, 0.75);
  }

  .primary-action > *:not(.panda-mascot-wrap):not(.signature-wrap) {
    position: relative;
    z-index: 2;
  }

  .signature-wrap {
    position: absolute;
    bottom: clamp(14px, 2.2vw, 28px);
    right: calc(clamp(110px, 22vw, 155px) + clamp(8px, 1.8vw, 22px));
    width: clamp(125px, 20vw, 185px);
    pointer-events: none;
    z-index: 2;
    transform-origin: center right;
    transform: rotate(-9deg);
    line-height: 0;
    opacity: 0.96;
    transition: opacity 0.3s var(--ease-out);
  }

  .signature-svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .sig-name {
    stroke-dasharray: 1080;
    stroke-dashoffset: 1080;
    transition: stroke-dashoffset 0.95s cubic-bezier(0.45, 0, 0.2, 1);
  }

  .sig-dot {
    opacity: 0;
    transform-origin: 172px 45px;
    transform: scale(0);
    transition: opacity 0.15s ease, transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .sig-flourish {
    stroke-dasharray: 610;
    stroke-dashoffset: 610;
    transition: stroke-dashoffset 0.55s cubic-bezier(0.2, 0.8, 0.25, 1);
  }

  /* When actively writing: tactile paper micro-shiver */
  .primary-action.is-signing {
    animation: paper-scrawl-shiver 0.08s infinite ease-in-out;
    will-change: transform;
  }

  .primary-action.is-signing .sig-name,
  .primary-action.has-drawn .sig-name {
    stroke-dashoffset: 0;
  }

  .primary-action.is-signing .sig-dot,
  .primary-action.has-drawn .sig-dot {
    opacity: 1;
    transform: scale(1);
    transition-delay: 0.92s;
  }

  .primary-action.is-signing .sig-flourish,
  .primary-action.has-drawn .sig-flourish {
    stroke-dashoffset: 0;
    transition-delay: 1.05s;
  }

  .primary-action:not(.is-signing):not(.has-drawn) .sig-name {
    stroke-dashoffset: 1080;
    transition: none;
  }

  .primary-action:not(.is-signing):not(.has-drawn) .sig-dot {
    opacity: 0;
    transform: scale(0);
    transition: none;
  }

  .primary-action:not(.is-signing):not(.has-drawn) .sig-flourish {
    stroke-dashoffset: 610;
    transition: none;
  }

  /* Ambient floating breathe once drawn and not actively signing */
  .primary-action.has-drawn:not(.is-signing) .signature-wrap {
    animation: signature-float 3.6s ease-in-out infinite alternate;
  }

  .panda-mascot-wrap {
    position: absolute;
    bottom: 4px;
    right: clamp(10px, 2.5vw, 24px);
    width: clamp(110px, 22vw, 155px);
    pointer-events: none;
    z-index: 1;
    line-height: 0;
  }

  .panda-mascot-img {
    width: 100%;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 6px 20px rgba(255, 183, 3, 0.35)) drop-shadow(0 12px 28px rgba(0, 0, 0, 0.6));
    transition: transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .primary-action:hover .panda-mascot-img {
    transform: translateY(-5px) scale(1.06) rotate(-2deg);
  }

  .action-title {
    font-size: var(--step-3);
    color: var(--color-text);
  }

  .action-desc {
    margin: 0;
    font-size: var(--step-0);
    color: var(--color-muted);
    line-height: 1.5;
  }

  .cta-stack {
    display: flex;
    align-items: flex-start;
    gap: var(--space-xs);
  }

  .contact-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-xs);
    padding: var(--space-xs) var(--space-m);
    min-height: 44px;
    border-radius: 9999px;
    font-family: var(--font-display);
    font-size: var(--step-0);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    transition: transform 0.25s var(--ease-out), box-shadow 0.25s var(--ease-out);
  }

  .cta-email {
    background: var(--gradient-neon);
    color: var(--color-bg);
    box-shadow: 0 0 20px rgba(231, 111, 81, 0.3);
  }

  .cta-email:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 32px rgba(231, 111, 81, 0.55);
  }

  .cta-icon {
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
  }

  .direct-email-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-xs);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--color-muted);
    padding-top: var(--space-xs);
    padding-right: clamp(75px, 20vw, 120px);
    border-top: 1px solid var(--color-line);
  }

  .lbl {
    flex-shrink: 0;
  }

  .email-val {
    color: var(--color-neon);
    user-select: all;
    word-break: normal;
    overflow-wrap: break-word;
  }

  @media (max-width: 480px) {
    .primary-action {
      padding-bottom: 5.25rem;
    }

    .direct-email-row {
      font-size: 0.72rem;
      padding-right: 0;
    }

    .panda-mascot-wrap {
      width: 76px;
      right: 10px;
      bottom: 6px;
    }

    .signature-wrap {
      width: 86px;
      right: 86px;
      bottom: 12px;
    }
  }

  /* Registry Card */
  .registry-title {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    text-transform: uppercase;
    color: var(--color-muted);
    letter-spacing: 0.1em;
    padding-bottom: var(--space-xs);
    border-bottom: 1px solid var(--color-line);
  }

  .socials-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .social-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    min-height: 44px;
    padding: var(--space-2xs) 0;
    border-bottom: 1px solid var(--color-line);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--color-text);
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .social-row:hover {
    color: var(--color-neon);
    border-color: var(--color-neon);
  }

  .social-name {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .accreditation-seal {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-xs);
    border-radius: 8px;
    background: rgba(42, 157, 143, 0.06);
    border: 1px solid rgba(42, 157, 143, 0.2);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--color-cyan);
    letter-spacing: 0.05em;
  }

  .icon-seal {
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
  }

  /* Colophon */
  .colophon-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-m);
    padding: var(--space-l) 0 var(--space-2xl);
    border-top: 1px solid var(--color-line);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--color-muted);
    letter-spacing: 0.05em;
  }

  .colophon-left {
    display: flex;
    align-items: center;
    gap: var(--space-m);
  }

  .brand-wordmark {
    font-family: var(--font-display);
    font-size: var(--step-0);
    font-weight: 800;
    color: var(--color-text);
  }

  .icon-tiny {
    width: 0.85rem;
    height: 0.85rem;
  }

  .icon-small {
    width: 1.1rem;
    height: 1.1rem;
  }

  @keyframes paper-scrawl-shiver {
    0% { transform: translate3d(0, 0, 0) rotate(0deg); }
    15% { transform: translate3d(-0.7px, 0.5px, 0) rotate(-0.09deg); }
    30% { transform: translate3d(0.9px, -0.6px, 0) rotate(0.12deg); }
    45% { transform: translate3d(-0.6px, -0.4px, 0) rotate(-0.07deg); }
    60% { transform: translate3d(0.8px, 0.7px, 0) rotate(0.1deg); }
    75% { transform: translate3d(-0.9px, 0.3px, 0) rotate(-0.11deg); }
    90% { transform: translate3d(0.6px, -0.8px, 0) rotate(0.08deg); }
    100% { transform: translate3d(0, 0, 0) rotate(0deg); }
  }

  @keyframes signature-float {
    0% {
      transform: rotate(-9deg) translate3d(0, 0, 0) scale(1);
    }
    50% {
      transform: rotate(-7.5deg) translate3d(0, -4px, 0) scale(1.02);
    }
    100% {
      transform: rotate(-10deg) translate3d(0, 2px, 0) scale(0.99);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .primary-action.is-signing {
      animation: none !important;
    }
    .signature-wrap {
      animation: none !important;
      transform: rotate(-9deg) !important;
    }
    .sig-name,
    .sig-flourish {
      stroke-dashoffset: 0 !important;
      transition: none !important;
    }
    .sig-dot {
      opacity: 1 !important;
      transform: scale(1) !important;
      transition: none !important;
    }
  }
</style>

<script>
  const primaryAction = document.querySelector('.primary-action');
  if (primaryAction) {
    let hasPlayed = false;
    let signingTimer: ReturnType<typeof setTimeout> | null = null;

    function playSigning() {
      if (signingTimer) clearTimeout(signingTimer);
      primaryAction?.classList.remove('is-signing', 'has-drawn');
      // Trigger DOM reflow to restart CSS stroke transitions cleanly
      void primaryAction?.offsetWidth;
      primaryAction?.classList.add('is-signing');

      signingTimer = setTimeout(() => {
        primaryAction?.classList.remove('is-signing');
        primaryAction?.classList.add('has-drawn');
      }, 1600);
    }

    // Trigger on viewport intersection
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting && !hasPlayed) {
              hasPlayed = true;
              playSigning();
            }
          });
        },
        { threshold: 0.25 }
      );
      observer.observe(primaryAction);
    } else {
      playSigning();
    }

    // Re-flourish on card hover (with debounce)
    let hoverDebounce: ReturnType<typeof setTimeout> | null = null;
    primaryAction.addEventListener('mouseenter', () => {
      if (primaryAction.classList.contains('is-signing')) return;
      if (hoverDebounce) clearTimeout(hoverDebounce);
      hoverDebounce = setTimeout(() => {
        playSigning();
      }, 200);
    });
  }
</script>
