---
import { site } from '../data/site.js';
import { Mail, ExternalLink, Sparkles, CheckCircle, ArrowUpRight, Instagram, Youtube, Linkedin } from 'lucide-astro';
import { Image } from 'astro:assets';
import pandaMail from '../assets/photos/panda-mail.webp';
import Signature from './Signature.astro';

const handle = (url: string) => url.split('/').filter(Boolean).pop()?.replace('@', '') || '';
const socials = [
  ...site.profiles.instagram.map((url) => ({ url, icon: Instagram, handle: `@${handle(url)}` })),
  ...site.profiles.youtube.map((url) => ({ url, icon: Youtube, handle: `@${handle(url)}` })),
  { url: site.profiles.linkedin, icon: Linkedin, handle: 'abhishek-pandey' },
];

---
<div class="boundary-container">
  <div class="marquee-ribbon" aria-hidden="true">
    <div class="marquee-track">
      <div class="marquee-content">
        <span>BRAND SPONSORSHIPS</span>
        <span class="sep">///</span>
        <span class="highlight">LIVE EVENT COVERAGE</span>
        <span class="sep">///</span>
        <span>MEDIA APPEARANCES</span>
        <span class="sep">///</span>
        <span class="highlight">CRICKET ACADEMY COLLABORATIONS</span>
        <span class="sep">///</span>
      </div>
      <div class="marquee-content">
        <span>BRAND SPONSORSHIPS</span>
        <span class="sep">///</span>
        <span class="highlight">LIVE EVENT COVERAGE</span>
        <span class="sep">///</span>
        <span>MEDIA APPEARANCES</span>
        <span class="sep">///</span>
        <span class="highlight">CRICKET ACADEMY COLLABORATIONS</span>
        <span class="sep">///</span>
      </div>
      <div class="marquee-content">
        <span>BRAND SPONSORSHIPS</span>
        <span class="sep">///</span>
        <span class="highlight">LIVE EVENT COVERAGE</span>
        <span class="sep">///</span>
        <span>MEDIA APPEARANCES</span>
        <span class="sep">///</span>
        <span class="highlight">CRICKET ACADEMY COLLABORATIONS</span>
        <span class="sep">///</span>
      </div>
      <div class="marquee-content">
        <span>BRAND SPONSORSHIPS</span>
        <span class="sep">///</span>
        <span class="highlight">LIVE EVENT COVERAGE</span>
        <span class="sep">///</span>
        <span>MEDIA APPEARANCES</span>
        <span class="sep">///</span>
        <span class="highlight">CRICKET ACADEMY COLLABORATIONS</span>
        <span class="sep">///</span>
      </div>
    </div>
  </div>

  <div class="boundary-main">
    <header class="boundary-header">
      <p class="kicker reveal-text">
        <span class="hud-pill neon"><Sparkles class="icon-tiny" /> COLLABORATIONS</span>
      </p>
      <h2 class="massive-headline reveal-text">LET'S BUILD SOMETHING ICONIC.</h2>
      <figure class="boundary-quote">
        <blockquote class="reveal-text">My approach is simple: keep things authentic, respect the audience’s time, and make videos that are both enjoyable and easy to connect with.</blockquote>
        <figcaption>Abhishek Pandey</figcaption>
      </figure>
    </header>

    <div class="action-grid">
      <div class="action-card primary-action">
        <h3 class="action-title">Start a Conversation</h3>
        <p class="action-desc">
          Email a short brief with what you want to promote and when.
        </p>

        <div class="cta-stack">
          <a class="contact-cta cta-email magnetic" href="/go/email" data-cursor-text="EMAIL">
            <Mail class="cta-icon" />
            <span>Email Abhishek</span>
            <ArrowUpRight class="icon-small" />
          </a>
        </div>

        <div class="direct-email-row">
          <span class="lbl">EMAIL:</span>
          <span class="email-val">{site.email}</span>
        </div>

        <div class="signature-wrap" aria-hidden="true">
          <Signature class="signature-svg" />
        </div>

        <div class="panda-mascot-wrap" aria-hidden="true">
          <Image
            src={pandaMail}
            alt="Panda mail mascot"
            class="panda-mascot-img"
            loading="lazy"
            width={240}
            height={283}
          />
        </div>
      </div>

      <div class="action-card registry-card">
        <h3 class="registry-title">Channels</h3>
        <ul class="socials-list" role="list">
          {socials.map((s) => (
            <li>
              <a class="social-row magnetic" href={s.url} target="_blank" rel="noopener" data-cursor-text="VISIT">
                <span class="social-name"><s.icon class="icon-small" /> {s.handle}</span>
                <ExternalLink class="icon-tiny" />
              </a>
            </li>
          ))}
        </ul>

        <div class="accreditation-seal">
          <CheckCircle class="icon-seal" />
          <span>DPL FIELD-OF-PLAY ACCREDITED MEDIA</span>
        </div>
      </div>
    </div>

    <footer class="colophon-bar">
      <div class="colophon-left">
        <span class="brand-wordmark">{site.name}</span>
        <span class="copyright-text">© {new Date().getFullYear()} · All rights reserved</span>
      </div>
    </footer>
  </div>
</div>

<style>
  .boundary-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    width: 100%;
    margin-top: var(--space-xl);
  }

  .boundary-main {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
    max-width: 86rem;
    margin: 0 auto;
    width: 100%;
    padding: 0 var(--space-m);
  }

  .boundary-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    max-width: 65ch;
  }

  .massive-headline {
    font-size: clamp(2.25rem, 6.5vw, 7.5rem);
    line-height: 0.92;
    letter-spacing: -0.02em;
    color: var(--color-text);
    word-break: break-word;
  }

  .boundary-quote {
    margin: 0;
    padding-left: var(--space-m);
    border-left: 3px solid var(--color-neon);
  }

  .boundary-quote blockquote {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--step-1);
    font-style: italic;
    color: var(--color-text);
    line-height: 1.5;
  }

  .boundary-quote figcaption {
    margin-top: var(--space-xs);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  /* Action Grid */
  .action-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-l);
    width: 100%;
  }

  @media (min-width: 58rem) {
    .action-grid {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    }
  }

  .action-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
    padding: clamp(var(--space-m), 4vw, var(--space-xl));
    background: var(--glass-bg);
    border: var(--glass-border);
    border-top-color: var(--glass-border-top);
    border-left-color: var(--glass-border-left);
    border-bottom-color: var(--glass-border-bottom);
    border-radius: var(--glass-radius);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    box-shadow: var(--glass-highlight), 0 16px 40px -10px rgba(0, 0, 0, 0.65);
    transition: border-color 0.3s var(--ease-out), box-shadow 0.3s var(--ease-out), background 0.3s var(--ease-out);
  }

  .primary-action {
    position: relative;
    overflow: hidden;
    border-color: rgba(231, 111, 81, 0.4);
    border-top-color: rgba(255, 140, 120, 0.6);
    box-shadow: var(--glass-highlight-hover), 0 20px 50px rgba(0, 0, 0, 0.75);
  }

  .primary-action > *:not(.panda-mascot-wrap):not(.signature-wrap) {
    position: relative;
    z-index: 2;
  }

  .signature-wrap {
    position: absolute;
    bottom: clamp(12px, 2vw, 24px);
    right: calc(clamp(110px, 22vw, 155px) + clamp(8px, 1.6vw, 20px));
    width: clamp(140px, 22vw, 220px);
    pointer-events: none;
    z-index: 2;
    transform-origin: center right;
    transform: rotate(-7deg);
    line-height: 0;
    transition: opacity 0.3s var(--ease-out);
  }

  .signature-svg {
    width: 100%;
    height: auto;
    overflow: visible;
    display: block;
    clip-path: inset(0 100% 0 0);
    filter: drop-shadow(0 0 12px rgba(231, 111, 81, 0.45));
    transition: clip-path 1.55s cubic-bezier(0.38, 0, 0.22, 1), filter 0.4s ease;
  }

  /* When actively writing: clip-path sweeps from left to right like pen writing */
  .primary-action.is-signing .signature-svg,
  .primary-action.has-drawn .signature-svg {
    clip-path: inset(0 0% 0 0);
  }

  .primary-action:not(.is-signing):not(.has-drawn) .signature-svg {
    clip-path: inset(0 100% 0 0);
    transition: none;
  }

  /* Tactile paper micro-shiver while writing */
  .primary-action.is-signing {
    animation: paper-scrawl-shiver 0.08s infinite ease-in-out;
    will-change: transform;
  }

  /* Ambient glowing floating breathe once drawn and settled */
  .primary-action.has-drawn:not(.is-signing) .signature-wrap {
    animation: signature-float 3.8s ease-in-out infinite alternate;
  }

  .primary-action.has-drawn:not(.is-signing) .signature-svg {
    animation: signature-glow-pulse 3.8s ease-in-out infinite alternate;
  }

  .panda-mascot-wrap {
    position: absolute;
    bottom: 4px;
    right: clamp(10px, 2.5vw, 24px);
    width: clamp(110px, 22vw, 155px);
    pointer-events: none;
    z-index: 1;
    line-height: 0;
  }

  .panda-mascot-img {
    width: 100%;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 6px 20px rgba(255, 183, 3, 0.35)) drop-shadow(0 12px 28px rgba(0, 0, 0, 0.6));
    transition: transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .primary-action:hover .panda-mascot-img {
    transform: translateY(-5px) scale(1.06) rotate(-2deg);
  }

  .action-title {
    font-size: var(--step-3);
    color: var(--color-text);
  }

  .action-desc {
    margin: 0;
    font-size: var(--step-0);
    color: var(--color-muted);
    line-height: 1.5;
  }

  .cta-stack {
    display: flex;
    align-items: flex-start;
    gap: var(--space-xs);
  }

  .contact-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-xs);
    padding: var(--space-xs) var(--space-m);
    min-height: 44px;
    border-radius: 9999px;
    font-family: var(--font-display);
    font-size: var(--step-0);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    transition: transform 0.25s var(--ease-out), box-shadow 0.25s var(--ease-out);
  }

  .cta-email {
    background: var(--gradient-neon);
    color: var(--color-bg);
    box-shadow: 0 0 20px rgba(231, 111, 81, 0.3);
  }

  .cta-email:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 32px rgba(231, 111, 81, 0.55);
  }

  .cta-icon {
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
  }

  .direct-email-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-xs);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--color-muted);
    padding-top: var(--space-xs);
    padding-right: clamp(75px, 20vw, 120px);
    border-top: 1px solid var(--color-line);
  }

  .lbl {
    flex-shrink: 0;
  }

  .email-val {
    color: var(--color-neon);
    user-select: all;
    word-break: normal;
    overflow-wrap: break-word;
  }

  @media (max-width: 480px) {
    .primary-action {
      padding-bottom: 5.25rem;
    }

    .direct-email-row {
      font-size: 0.72rem;
      padding-right: 0;
    }

    .panda-mascot-wrap {
      width: 76px;
      right: 10px;
      bottom: 6px;
    }

    .signature-wrap {
      width: 86px;
      right: 86px;
      bottom: 12px;
    }
  }

  /* Registry Card */
  .registry-title {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    text-transform: uppercase;
    color: var(--color-muted);
    letter-spacing: 0.1em;
    padding-bottom: var(--space-xs);
    border-bottom: 1px solid var(--color-line);
  }

  .socials-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .social-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    min-height: 44px;
    padding: var(--space-2xs) 0;
    border-bottom: 1px solid var(--color-line);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--color-text);
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .social-row:hover {
    color: var(--color-neon);
    border-color: var(--color-neon);
  }

  .social-name {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .accreditation-seal {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-xs);
    border-radius: 8px;
    background: rgba(42, 157, 143, 0.06);
    border: 1px solid rgba(42, 157, 143, 0.2);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--color-cyan);
    letter-spacing: 0.05em;
  }

  .icon-seal {
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
  }

  /* Colophon */
  .colophon-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-m);
    padding: var(--space-l) 0 var(--space-2xl);
    border-top: 1px solid var(--color-line);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--color-muted);
    letter-spacing: 0.05em;
  }

  .colophon-left {
    display: flex;
    align-items: center;
    gap: var(--space-m);
  }

  .brand-wordmark {
    font-family: var(--font-display);
    font-size: var(--step-0);
    font-weight: 800;
    color: var(--color-text);
  }

  .icon-tiny {
    width: 0.85rem;
    height: 0.85rem;
  }

  .icon-small {
    width: 1.1rem;
    height: 1.1rem;
  }

  @keyframes paper-scrawl-shiver {
    0% { transform: translate3d(0, 0, 0) rotate(0deg); }
    15% { transform: translate3d(-0.7px, 0.5px, 0) rotate(-0.09deg); }
    30% { transform: translate3d(0.9px, -0.6px, 0) rotate(0.12deg); }
    45% { transform: translate3d(-0.6px, -0.4px, 0) rotate(-0.07deg); }
    60% { transform: translate3d(0.8px, 0.7px, 0) rotate(0.1deg); }
    75% { transform: translate3d(-0.9px, 0.3px, 0) rotate(-0.11deg); }
    90% { transform: translate3d(0.6px, -0.8px, 0) rotate(0.08deg); }
    100% { transform: translate3d(0, 0, 0) rotate(0deg); }
  }

  @keyframes signature-float {
    0% {
      transform: rotate(-7deg) translate3d(0, 0, 0) scale(1);
    }
    50% {
      transform: rotate(-5.5deg) translate3d(0, -4px, 0) scale(1.02);
    }
    100% {
      transform: rotate(-8deg) translate3d(0, 2px, 0) scale(0.99);
    }
  }

  @keyframes signature-glow-pulse {
    0% {
      filter: drop-shadow(0 0 10px rgba(231, 111, 81, 0.4)) drop-shadow(0 2px 14px rgba(255, 183, 3, 0.25));
      opacity: 0.94;
    }
    100% {
      filter: drop-shadow(0 0 20px rgba(231, 111, 81, 0.85)) drop-shadow(0 4px 30px rgba(255, 183, 3, 0.55));
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .primary-action.is-signing {
      animation: none !important;
    }
    .signature-wrap {
      animation: none !important;
      transform: rotate(-7deg) !important;
    }
    .signature-svg {
      clip-path: inset(0 0% 0 0) !important;
      transition: none !important;
      animation: none !important;
    }
  }
</style>

<script>
  const primaryAction = document.querySelector('.primary-action');
  if (primaryAction) {
    let hasPlayed = false;
    let signingTimer: ReturnType<typeof setTimeout> | null = null;

    function playSigning() {
      if (signingTimer) clearTimeout(signingTimer);
      primaryAction?.classList.remove('is-signing', 'has-drawn');
      // Trigger DOM reflow to restart CSS stroke transitions cleanly
      void primaryAction?.offsetWidth;
      primaryAction?.classList.add('is-signing');

      signingTimer = setTimeout(() => {
        primaryAction?.classList.remove('is-signing');
        primaryAction?.classList.add('has-drawn');
      }, 1600);
    }

    // Trigger on viewport intersection
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting && !hasPlayed) {
              hasPlayed = true;
              playSigning();
            }
          });
        },
        { threshold: 0.25 }
      );
      observer.observe(primaryAction);
    } else {
      playSigning();
    }

    // Re-flourish on card hover (with debounce)
    let hoverDebounce: ReturnType<typeof setTimeout> | null = null;
    primaryAction.addEventListener('mouseenter', () => {
      if (primaryAction.classList.contains('is-signing')) return;
      if (hoverDebounce) clearTimeout(hoverDebounce);
      hoverDebounce = setTimeout(() => {
        playSigning();
      }, 200);
    });
  }
</script>
