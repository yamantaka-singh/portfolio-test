---
import { Image } from 'astro:assets';
import { social, profilesBy, thumb } from '../lib/social.js';
import { compactCount } from '../lib/format.js';
import { Instagram, Heart, Play, Flame, Sparkles, ExternalLink } from 'lucide-astro';

const accounts = profilesBy('instagram');

// Sort posts by highest likes / engagement first
const topPosts = [...social.posts]
  .sort((a, b) => (b.likes ?? 0) - (a.likes ?? 0))
  .slice(0, 6);
---
<div class="stands-container">
  <header class="stands-header">
    <div class="header-left">
      <p class="kicker reveal-text">
        <span class="hud-pill neon"><Instagram class="icon-tiny" /> FAN STANDS</span>
        THE STANDS // INSTAGRAM REELS &amp; MOMENTS
      </p>
      <h2 class="stands-title reveal-text">PULSE OF THE CROWD.</h2>
      <p class="stands-subtitle reveal-text">
        Short-form viral reels, pitchside encounters with star players, and fan milestones.
      </p>
    </div>
    <div class="header-right">
      {accounts.map((a) => (
        <a class="follow-pill magnetic" href={a.url} target="_blank" rel="noopener" data-cursor-text="FOLLOW">
          <Instagram class="icon-small" />
          <span>@{a.handle}</span>
          {a.followers != null && <span class="badge-count">{compactCount(a.followers)}</span>}
        </a>
      ))}
    </div>
  </header>

  <!-- Horizontal Scrollable Reel Track -->
  <div class="carousel-wrapper" data-lenis-prevent>
    <div class="reels-track" role="list">
      {topPosts.map((p, idx) => (
        <div class="reel-card tilt-card tilt-pop" role="listitem" data-cursor-text="VIEW">
          <a
            class="reel-anchor"
            href={p.url}
            target="_blank"
            rel="noopener"
            aria-label={p.caption || `Instagram post by @${p.account}`}
          >
            <div class="thumb-frame">
              <Image 
                class="reel-thumb" 
                src={thumb(p.thumb)} 
                alt="" 
                widths={[360, 640]} 
                sizes="(min-width: 64rem) 260px, 60vw" 
              />
              <div class="frame-vignette"></div>

              <!-- Badges -->
              <div class="reel-top-badges">
                {p.isReel ? (
                  <span class="type-pill reel-pill"><Play class="icon-micro" /> REEL</span>
                ) : (
                  <span class="type-pill post-pill"><Sparkles class="icon-micro" /> MOMENT</span>
                )}
                <span class="index-pill">#0{idx + 1}</span>
              </div>

              <!-- Bottom Content Overlay -->
              <div class="reel-bottom-info">
                {p.likes != null && (
                  <div class="likes-chip">
                    <Heart class="icon-heart" />
                    <span>{compactCount(p.likes)} LIKES</span>
                  </div>
                )}
                {p.caption && <p class="caption-text">{p.caption}</p>}
              </div>
            </div>
          </a>
        </div>
      ))}
    </div>
  </div>

  <!-- Community Quote Ribbon -->
  <div class="marquee-ribbon" aria-hidden="true">
    <div class="marquee-track reverse">
      <div class="marquee-content">
        <span class="dim">"The sharpest technical analysis on YouTube"</span>
        <span class="sep">///</span>
        <span class="highlight">"Dissects seam angles like no other creator"</span>
        <span class="sep">///</span>
        <span class="dim">"From the West Stand to the Field of Play"</span>
        <span class="sep">///</span>
        <span class="highlight">"180,000+ passionate cricket purists"</span>
        <span class="sep">///</span>
      </div>
      <div class="marquee-content">
        <span class="dim">"The sharpest technical analysis on YouTube"</span>
        <span class="sep">///</span>
        <span class="highlight">"Dissects seam angles like no other creator"</span>
        <span class="sep">///</span>
        <span class="dim">"From the West Stand to the Field of Play"</span>
        <span class="sep">///</span>
        <span class="highlight">"180,000+ passionate cricket purists"</span>
        <span class="sep">///</span>
      </div>
      <div class="marquee-content">
        <span class="dim">"The sharpest technical analysis on YouTube"</span>
        <span class="sep">///</span>
        <span class="highlight">"Dissects seam angles like no other creator"</span>
        <span class="sep">///</span>
        <span class="dim">"From the West Stand to the Field of Play"</span>
        <span class="sep">///</span>
        <span class="highlight">"180,000+ passionate cricket purists"</span>
        <span class="sep">///</span>
      </div>
      <div class="marquee-content">
        <span class="dim">"The sharpest technical analysis on YouTube"</span>
        <span class="sep">///</span>
        <span class="highlight">"Dissects seam angles like no other creator"</span>
        <span class="sep">///</span>
        <span class="dim">"From the West Stand to the Field of Play"</span>
        <span class="sep">///</span>
        <span class="highlight">"180,000+ passionate cricket purists"</span>
        <span class="sep">///</span>
      </div>
    </div>
  </div>
</div>

<style>
  .stands-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-l);
    width: 100%;
    max-width: 86rem;
    margin: 0 auto;
  }

  .stands-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: var(--space-m);
    padding-bottom: var(--space-s);
    border-bottom: 1px solid var(--color-line);
  }

  .header-left {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    max-width: 54ch;
  }

  .stands-title {
    font-size: clamp(2.5rem, 6vw, 5.5rem);
    color: var(--color-text);
  }

  .stands-subtitle {
    margin: 0;
    font-size: var(--step-0);
    color: var(--color-muted);
    line-height: 1.5;
  }

  .follow-pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-xs) var(--space-m);
    border-radius: 9999px;
    border: 1px solid var(--color-line-bright);
    background: rgba(17, 20, 29, 0.75);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--color-text);
    transition: all 0.25s var(--ease-out);
  }

  .follow-pill:hover {
    border-color: var(--color-neon);
    color: var(--color-neon);
    background: rgba(231, 111, 81, 0.1);
  }

  .badge-count {
    padding: 2px 6px;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.12);
    font-size: var(--step--2);
    color: #FFF;
  }

  .carousel-wrapper {
    width: 100%;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    padding-bottom: var(--space-m);
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x mandatory;
    padding-inline: 4px;
  }

  .carousel-wrapper::-webkit-scrollbar {
    display: none;
  }

  .reels-track {
    display: flex;
    gap: var(--space-m);
    width: max-content;
    padding-right: var(--space-m);
  }

  .reel-card {
    width: clamp(190px, 48vw, 260px);
    flex: 0 0 auto;
    scroll-snap-align: start;
    background: var(--color-card);
    border: 1px solid var(--color-line);
    border-radius: 12px;
    padding: var(--space-2xs);
    backdrop-filter: blur(12px);
    transition: transform 0.3s var(--ease-out), border-color 0.3s var(--ease-out), box-shadow 0.3s var(--ease-out);
  }

  .reel-card:hover {
    position: relative;
    z-index: 2;
    border-color: var(--color-blood);
    box-shadow: 0 24px 50px rgba(0, 0, 0, 0.75), 0 0 32px rgba(141, 8, 1, 0.5);
    /* transform (the actual "pop out" scale) is driven by initTiltCards()'s
       GSAP tween on this .tilt-pop card, not CSS -- see interactions.js */
  }

  .reel-anchor {
    display: block;
    width: 100%;
    height: 100%;
    text-decoration: none;
  }

  .thumb-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 9 / 16;
    border-radius: 8px;
    overflow: hidden;
    background: var(--color-surface);
  }

  .reel-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: contrast(1.08) brightness(0.95);
    transition: transform 0.6s var(--ease-out);
  }

  .reel-card:hover .reel-thumb {
    filter: contrast(1.15) brightness(1.02);
  }

  .frame-vignette {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(7, 9, 14, 0.95) 0%, rgba(7, 9, 14, 0.2) 50%, transparent 100%);
    pointer-events: none;
  }

  .reel-top-badges {
    position: absolute;
    top: var(--space-xs);
    left: var(--space-xs);
    right: var(--space-xs);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .type-pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3xs);
    padding: var(--space-3xs) var(--space-xs);
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    backdrop-filter: blur(8px);
  }

  .reel-pill {
    background: rgba(141, 8, 1, 0.85);
    color: #FFF;
  }

  .post-pill {
    background: rgba(42, 157, 143, 0.85);
    color: var(--color-bg);
  }

  .index-pill {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--color-neon);
    background: rgba(7, 9, 14, 0.85);
    padding: var(--space-3xs) var(--space-xs);
    border-radius: 4px;
    border: 1px solid var(--color-line);
  }

  .reel-bottom-info {
    position: absolute;
    bottom: var(--space-xs);
    left: var(--space-xs);
    right: var(--space-xs);
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .likes-chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3xs);
    align-self: flex-start;
    padding: 2px 8px;
    border-radius: 4px;
    background: rgba(7, 9, 14, 0.85);
    border: 1px solid rgba(255, 51, 68, 0.4);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 700;
    color: var(--color-crimson);
  }

  .icon-heart {
    width: 0.8rem;
    height: 0.8rem;
    fill: var(--color-crimson);
  }

  .caption-text {
    margin: 0;
    font-size: var(--step--2);
    color: var(--color-text);
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .icon-tiny {
    width: 0.85rem;
    height: 0.85rem;
  }

  .icon-small {
    width: 1rem;
    height: 1rem;
  }

  .icon-micro {
    width: 0.75rem;
    height: 0.75rem;
  }
</style>
