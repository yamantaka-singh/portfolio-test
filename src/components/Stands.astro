---
import { Image } from 'astro:assets';
import { profilesBy, thumb, topReels } from '../lib/social.js';
import { compactCount } from '../lib/format.js';
import { Instagram, Heart, Eye, Play, Sparkles } from 'lucide-astro';

const accounts = profilesBy('instagram');

// Most-watched of all time, across the scraped pool and the curated tournament reels
// (the scrape only sees recent reels, which are not the biggest ones).
const topPosts = topReels.slice(0, 6);
---
<div class="stands-container">
  <header class="stands-header">
    <div class="header-left">
      <p class="kicker reveal-text">
        <span class="hud-pill neon"><Instagram class="icon-tiny" /> INSTAGRAM</span>
      </p>
      <h2 class="stands-title reveal-text">PULSE OF THE CROWD.</h2>
      <p class="stands-subtitle reveal-text">
        The most-watched reels across @abhishekpandey_26 and @spinandswing26, including the Story Behind the Post interviews with DPL players.
      </p>
    </div>
    <div class="header-right">
      {accounts.map((a) => (
        <a class="follow-pill magnetic" href={a.url} target="_blank" rel="noopener" data-cursor-text="FOLLOW">
          <Instagram class="icon-small" />
          <span>@{a.handle}</span>
          {a.followers != null && <span class="badge-count">{compactCount(a.followers)}</span>}
        </a>
      ))}
    </div>
  </header>

  <!-- Horizontal Scrollable Reel Track -->
  <div class="carousel-wrapper">
    <div class="reels-track" role="list">
      {topPosts.map((p, idx) => (
        <div class="reel-card tilt-card tilt-pop" role="listitem" data-cursor-text="VIEW">
          <a
            class="reel-anchor"
            href={p.url}
            target="_blank"
            rel="noopener"
            aria-label={p.caption || `Instagram post by @${p.account}`}
          >
            <div class="thumb-frame">
              <Image 
                class="reel-thumb" 
                src={thumb(p.thumb)}
                alt={p.caption || `Instagram reel by @${p.account}`}
                widths={[360, 640]}
                sizes="(min-width: 64rem) 260px, 60vw" 
              />
              <div class="frame-vignette"></div>

              <!-- Badges -->
              <div class="reel-top-badges">
                {p.isReel ? (
                  <span class="type-pill reel-pill"><Play class="icon-micro" /> REEL</span>
                ) : (
                  <span class="type-pill post-pill"><Sparkles class="icon-micro" /> MOMENT</span>
                )}
              </div>

              <!-- Bottom Content Overlay -->
              <div class="reel-bottom-info">
                <div class="metric-chips">
                  {p.views != null && (
                    <div class="views-chip">
                      <Eye class="icon-eye" />
                      <span>{compactCount(p.views)}</span>
                    </div>
                  )}
                  {p.likes != null && (
                    <div class="likes-chip">
                      <Heart class="icon-heart" />
                      <span>{compactCount(p.likes)}</span>
                    </div>
                  )}
                </div>
                {p.caption && <p class="caption-text">{p.caption}</p>}
              </div>
            </div>
          </a>
        </div>
      ))}
    </div>
  </div>

  <div class="marquee-ribbon" aria-hidden="true">
    <div class="marquee-track reverse">
      <div class="marquee-content">
        <span class="dim">STORY BEHIND THE POST</span>
        <span class="sep">///</span>
        <span class="highlight">DPL 2026</span>
        <span class="sep">///</span>
        <span class="dim">FAN VOX POPS</span>
        <span class="sep">///</span>
        <span class="highlight">ICC MEN'S T20 WORLD CUP 2026</span>
        <span class="sep">///</span>
      </div>
      <div class="marquee-content">
        <span class="dim">STORY BEHIND THE POST</span>
        <span class="sep">///</span>
        <span class="highlight">DPL 2026</span>
        <span class="sep">///</span>
        <span class="dim">FAN VOX POPS</span>
        <span class="sep">///</span>
        <span class="highlight">ICC MEN'S T20 WORLD CUP 2026</span>
        <span class="sep">///</span>
      </div>
      <div class="marquee-content">
        <span class="dim">STORY BEHIND THE POST</span>
        <span class="sep">///</span>
        <span class="highlight">DPL 2026</span>
        <span class="sep">///</span>
        <span class="dim">FAN VOX POPS</span>
        <span class="sep">///</span>
        <span class="highlight">ICC MEN'S T20 WORLD CUP 2026</span>
        <span class="sep">///</span>
      </div>
      <div class="marquee-content">
        <span class="dim">STORY BEHIND THE POST</span>
        <span class="sep">///</span>
        <span class="highlight">DPL 2026</span>
        <span class="sep">///</span>
        <span class="dim">FAN VOX POPS</span>
        <span class="sep">///</span>
        <span class="highlight">ICC MEN'S T20 WORLD CUP 2026</span>
        <span class="sep">///</span>
      </div>
    </div>
  </div>
</div>

<style>
  .stands-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-l);
    width: 100%;
    max-width: 86rem;
    margin: 0 auto;
  }

  .stands-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: var(--space-m);
    padding-bottom: var(--space-s);
    border-bottom: 1px solid var(--color-line);
  }

  .header-left {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    max-width: 54ch;
  }

  .stands-title {
    font-size: clamp(2.5rem, 6vw, 5.5rem);
    color: var(--color-text);
  }

  .stands-subtitle {
    margin: 0;
    font-size: var(--step-0);
    color: var(--color-muted);
    line-height: 1.5;
  }

  .follow-pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-xs) var(--space-m);
    border-radius: 9999px;
    border: var(--glass-border);
    border-top-color: var(--glass-border-top);
    background: var(--glass-bg);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    box-shadow: var(--glass-highlight), 0 8px 24px rgba(0, 0, 0, 0.35);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--color-text);
    transition: all 0.25s var(--ease-out);
  }

  .follow-pill:hover {
    border-color: var(--color-neon);
    border-top-color: rgba(255, 140, 120, 0.6);
    color: var(--color-neon);
    background: var(--glass-bg-hover);
    box-shadow: var(--glass-highlight-hover), 0 0 24px rgba(231, 111, 81, 0.3);
  }

  .badge-count {
    padding: 2px 6px;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.12);
    font-size: var(--step--2);
    color: #FFF;
  }

  .carousel-wrapper {
    width: 100%;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    padding-block: var(--space-m);
    margin-block: calc(-1 * var(--space-m));
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x mandatory;
    padding-inline: var(--space-s);
  }

  .carousel-wrapper::-webkit-scrollbar {
    display: none;
  }

  .reels-track {
    display: flex;
    gap: var(--space-m);
    width: max-content;
    padding-block: var(--space-xs);
    padding-inline: var(--space-xs) var(--space-m);
  }

  .reel-card {
    position: relative;
    z-index: 1;
    width: clamp(190px, 48vw, 260px);
    flex: 0 0 auto;
    scroll-snap-align: start;
    background: var(--glass-bg);
    border: var(--glass-border);
    border-top-color: var(--glass-border-top);
    border-left-color: var(--glass-border-left);
    border-bottom-color: var(--glass-border-bottom);
    border-radius: var(--glass-radius);
    padding: var(--space-2xs);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    box-shadow: var(--glass-highlight), 0 16px 40px -10px rgba(0, 0, 0, 0.65);
    transition: transform 0.3s var(--ease-out), border-color 0.3s var(--ease-out), box-shadow 0.3s var(--ease-out), background 0.3s var(--ease-out);
  }

  .reel-card:hover {
    position: relative;
    z-index: 50;
    border-color: var(--color-neon);
    border-top-color: rgba(255, 140, 120, 0.6);
    background: var(--glass-bg-hover);
    box-shadow: var(--glass-highlight-hover), 0 24px 50px rgba(0, 0, 0, 0.8), 0 0 36px rgba(231, 111, 81, 0.4);
    /* transform (the actual "pop out" scale) is driven by initTiltCards()'s
       GSAP tween on this .tilt-pop card, not CSS -- see interactions.js */
  }

  .reel-anchor {
    display: block;
    width: 100%;
    height: 100%;
    text-decoration: none;
  }

  .thumb-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 9 / 16;
    border-radius: 8px;
    overflow: hidden;
    background: var(--color-surface);
  }

  .reel-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: contrast(1.08) brightness(0.95);
    transition: transform 0.6s var(--ease-out);
  }

  .reel-card:hover .reel-thumb {
    filter: contrast(1.15) brightness(1.02);
  }

  .frame-vignette {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(7, 9, 14, 0.95) 0%, rgba(7, 9, 14, 0.2) 50%, transparent 100%);
    pointer-events: none;
  }

  .reel-top-badges {
    position: absolute;
    top: var(--space-xs);
    left: var(--space-xs);
    right: var(--space-xs);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .type-pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3xs);
    padding: var(--space-3xs) var(--space-xs);
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    backdrop-filter: blur(8px);
  }

  .reel-pill {
    background: rgba(141, 8, 1, 0.85);
    color: #FFF;
  }

  .post-pill {
    background: rgba(42, 157, 143, 0.85);
    color: var(--color-bg);
  }

  .reel-bottom-info {
    position: absolute;
    bottom: var(--space-xs);
    left: var(--space-xs);
    right: var(--space-xs);
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .metric-chips {
    display: flex;
    gap: var(--space-2xs);
  }

  .likes-chip,
  .views-chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3xs);
    padding: 2px 8px;
    border-radius: 4px;
    background: rgba(7, 9, 14, 0.85);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 700;
  }

  .likes-chip {
    border: 1px solid rgba(255, 51, 68, 0.4);
    color: var(--color-crimson);
  }

  .views-chip {
    border: 1px solid var(--color-line);
    color: #FFF;
  }

  .icon-heart {
    width: 0.8rem;
    height: 0.8rem;
    fill: var(--color-crimson);
  }

  .icon-eye {
    width: 0.8rem;
    height: 0.8rem;
    color: var(--color-cyan);
  }

  .caption-text {
    margin: 0;
    font-size: var(--step--2);
    color: var(--color-text);
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .icon-tiny {
    width: 0.85rem;
    height: 0.85rem;
  }

  .icon-small {
    width: 1rem;
    height: 1rem;
  }

  .icon-micro {
    width: 0.75rem;
    height: 0.75rem;
  }
</style>
