---
import { Image } from 'astro:assets';
import { site } from '../data/site.js';
import { social } from '../lib/social.js';
import { scoreboardStats } from '../lib/stats.js';
import { compactCount } from '../lib/format.js';
import { Play, ArrowUpRight } from 'lucide-astro';
import heroPortrait from '../assets/photos/abhishek-tata-ipl.jpg';
import lordsHero from '../assets/photos/lords-stadium-sunny.jpg';

const { totalReach } = scoreboardStats(social);
const topViews = Math.max(0, ...social.videos.map((v) => v.views ?? 0));
---
<div class="hero-wrapper">
  <div class="video-bg" aria-hidden="true">
    <video
      class="video-element"
      src="/hero-section-2.mp4"
      autoplay
      muted
      loop
      playsinline
      poster={lordsHero.src}
    ></video>
    <div class="video-overlay"></div>
  </div>

  <div class="hero-container">
    <div class="hero-grid">
      <div class="hero-content">
        <p class="kicker hero-kicker reveal-text">
          <span class="kicker-badge">HOST // SPIN &amp; SWING</span>
          <span>CRICKET CREATOR &amp; TACTICAL ANALYST</span>
        </p>

        <h1 class="hero-title reveal-text">
          <span class="first-name">ABHISHEK</span>
          <span class="last-name">PANDEY</span>
        </h1>

        <p class="hero-lede reveal-text">{site.tagline}</p>

        <div class="cta-cluster">
          <a class="cta-primary magnetic" href="#pitch" data-cursor-text="WATCH">
            <span>Watch top videos</span>
            <span class="icon-bubble"><Play class="icon-small" /></span>
          </a>
          <a class="cta-secondary magnetic" href="#pavilion" data-cursor-text="STORY">
            <span>His story</span>
            <ArrowUpRight class="icon-small" />
          </a>
        </div>

        <div class="metric-ribbon">
          <div class="metric-cell">
            <span class="metric-num">{compactCount(totalReach)}</span>
            <span class="metric-lbl">Followers</span>
          </div>
          <div class="metric-cell">
            <span class="metric-num">50M+</span>
            <span class="metric-lbl">Total Impressions</span>
          </div>
          <div class="metric-cell">
            <span class="metric-num">{compactCount(topViews)}</span>
            <span class="metric-lbl">Views on top video</span>
          </div>
        </div>
      </div>

      <div class="hero-card-col">
        <div class="accreditation-card tilt-card" data-cursor-text="ABHISHEK">
          <div class="card-image-wrap">
            <Image
              src={heroPortrait}
              alt="Abhishek Pandey at a Tata IPL event"
              class="card-img"
              widths={[480, 800]}
              sizes="(min-width: 64rem) 380px, 85vw"
              priority
            />
            <div class="card-overlay-badge">
              <span class="badge-match">TATA IPL EVENT</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Marquee Ticker -->
  <div class="marquee-ribbon" aria-hidden="true">
    <div class="marquee-track">
      <div class="marquee-content">
        <span>SPIN &amp; SWING</span>
        <span class="sep">///</span>
        <span class="highlight">44.2K SUBSCRIBERS</span>
        <span class="sep">///</span>
        <span class="highlight">50,000,000+ IMPRESSIONS</span>
        <span class="sep">///</span>
        <span>POST-MATCH REACTIONS</span>
        <span class="sep">///</span>
        <span class="highlight">STADIUM VLOGS</span>
        <span class="sep">///</span>
      </div>
      <div class="marquee-content">
        <span>SPIN &amp; SWING</span>
        <span class="sep">///</span>
        <span class="highlight">44.2K SUBSCRIBERS</span>
        <span class="sep">///</span>
        <span class="highlight">50,000,000+ IMPRESSIONS</span>
        <span class="sep">///</span>
        <span>POST-MATCH REACTIONS</span>
        <span class="sep">///</span>
        <span class="highlight">STADIUM VLOGS</span>
        <span class="sep">///</span>
      </div>
      <div class="marquee-content">
        <span>SPIN &amp; SWING</span>
        <span class="sep">///</span>
        <span class="highlight">44.2K SUBSCRIBERS</span>
        <span class="sep">///</span>
        <span class="highlight">50,000,000+ IMPRESSIONS</span>
        <span class="sep">///</span>
        <span>POST-MATCH REACTIONS</span>
        <span class="sep">///</span>
        <span class="highlight">STADIUM VLOGS</span>
        <span class="sep">///</span>
      </div>
      <div class="marquee-content">
        <span>SPIN &amp; SWING</span>
        <span class="sep">///</span>
        <span class="highlight">44.2K SUBSCRIBERS</span>
        <span class="sep">///</span>
        <span class="highlight">50,000,000+ IMPRESSIONS</span>
        <span class="sep">///</span>
        <span>POST-MATCH REACTIONS</span>
        <span class="sep">///</span>
        <span class="highlight">STADIUM VLOGS</span>
        <span class="sep">///</span>
      </div>
    </div>
  </div>
</div>

<style>
  .hero-wrapper {
    position: relative;
    width: 100%;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    padding-top: clamp(var(--space-m), 4vw, var(--space-xl));
  }

  @media (max-width: 30rem) {
    .hero-wrapper {
      padding-top: var(--space-xs);
    }
  }

  .video-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .video-element {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 38%;
    filter: brightness(1.1) contrast(1.12) saturate(1.15);
    pointer-events: none;
    transform-origin: center center;
  }



  .video-overlay {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 75% 45%, rgba(42, 157, 143, 0.08) 0%, transparent 60%),
      radial-gradient(circle at 25% 65%, rgba(231, 111, 81, 0.06) 0%, transparent 60%),
      /* The source photo is brightest at the top (sky) and darkest at the bottom
         (pitch/stands) -- the opposite of the video this replaced -- so the darkening
         has to be strongest at the top, where the kicker/title text sits. */
      linear-gradient(to bottom, rgba(7, 9, 14, 0.78) 0%, rgba(7, 9, 14, 0.55) 35%, rgba(7, 9, 14, 0.38) 65%, var(--color-bg) 100%);
    z-index: 1;
    pointer-events: none;
  }

  @media (max-width: 48rem) {
    .video-overlay {
      background:
        radial-gradient(circle at 75% 45%, rgba(42, 157, 143, 0.08) 0%, transparent 60%),
        radial-gradient(circle at 25% 65%, rgba(231, 111, 81, 0.06) 0%, transparent 60%),
        linear-gradient(to bottom, rgba(7, 9, 14, 0.85) 0%, rgba(7, 9, 14, 0.68) 35%, rgba(7, 9, 14, 0.5) 65%, var(--color-bg) 100%);
    }
  }

  .hero-container {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 86rem;
    margin: 0 auto;
    padding: var(--space-s) clamp(1rem, 3.5vw, var(--space-xl));
    display: flex;
    flex-direction: column;
    gap: clamp(var(--space-m), 3vw, var(--space-l));
  }

  @media (max-width: 30rem) {
    .hero-container {
      padding-top: var(--space-2xs);
      padding-bottom: var(--space-2xs);
      gap: var(--space-xs);
    }
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(var(--space-l), 4vw, var(--space-2xl));
    align-items: center;
    width: 100%;
  }

  @media (min-width: 62rem) {
    .hero-grid {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.85fr);
      gap: var(--space-2xl);
    }
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    gap: clamp(var(--space-xs), 2vw, var(--space-m));
  }

  .hero-kicker {
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3xs);
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.85);
  }

  .kicker-badge {
    color: var(--color-neon);
    font-weight: 700;
  }

  .hero-title {
    display: flex;
    flex-direction: column;
    line-height: 0.9;
    letter-spacing: -0.02em;
    font-size: clamp(2.5rem, 8vw, 8.5rem);
    word-break: break-word;
  }

  @media (max-width: 30rem) {
    .hero-title {
      font-size: clamp(2.25rem, 12vw, 3.25rem);
    }
  }

  .first-name {
    color: var(--color-text);
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.75);
  }

  .last-name {
    color: transparent;
    -webkit-text-stroke: 1.5px var(--color-neon);
    text-shadow: var(--glow-neon), 0 4px 20px rgba(0, 0, 0, 0.75);
  }

  .hero-lede {
    margin: 0;
    max-width: 46ch;
    font-size: var(--step-0);
    color: var(--color-text);
    line-height: 1.5;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.85);
  }

  .cta-cluster {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-s);
    margin-top: var(--space-2xs);
  }

  @media (max-width: 32rem) {
    .cta-cluster {
      flex-direction: column;
      align-items: stretch;
    }
    .cta-primary, .cta-secondary {
      justify-content: center;
      width: 100%;
    }
  }

  .cta-primary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-s);
    padding: var(--space-xs) var(--space-l);
    border-radius: 9999px;
    background: var(--gradient-neon);
    color: var(--color-bg);
    font-family: var(--font-display);
    font-size: var(--step-0);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: transform 0.25s var(--ease-out), box-shadow 0.25s var(--ease-out);
    box-shadow: 0 0 24px rgba(231, 111, 81, 0.4);
    min-height: 44px;
  }

  .cta-primary:hover {
    transform: translateY(-2px) scale(1.02);
    box-shadow: 0 0 36px rgba(231, 111, 81, 0.65);
  }

  .icon-bubble {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.85rem;
    height: 1.85rem;
    border-radius: 50%;
    background: var(--color-bg);
    color: var(--color-neon);
  }

  .cta-secondary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-xs) var(--space-m);
    border-radius: 9999px;
    border: var(--glass-border);
    border-top-color: var(--glass-border-top);
    background: var(--glass-bg);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    box-shadow: var(--glass-highlight), 0 8px 24px rgba(0, 0, 0, 0.4);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text);
    transition: border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
    min-height: 44px;
  }

  .cta-secondary:hover {
    border-color: var(--color-neon);
    border-top-color: rgba(255, 140, 120, 0.6);
    background: var(--glass-bg-hover);
    box-shadow: var(--glass-highlight-hover), 0 0 24px rgba(231, 111, 81, 0.35);
  }

  .metric-ribbon {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(var(--space-2xs), 2vw, var(--space-s));
    padding-top: var(--space-s);
    border-top: 1px solid var(--color-line);
    margin-top: var(--space-xs);
  }

  @media (max-width: 30rem) {
    .metric-ribbon {
      padding-top: var(--space-2xs);
      margin-top: 0;
    }
  }

  .metric-cell {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .metric-num {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 3.5vw, var(--step-3));
    font-weight: 800;
    line-height: 1;
    color: var(--color-neon);
  }

  .metric-lbl {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    text-transform: uppercase;
    color: var(--color-text);
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.85);
    letter-spacing: 0.08em;
  }

  /* Accreditation Pass Card */
  .hero-card-col {
    display: flex;
    justify-content: center;
    perspective: 1000px;
  }

  .accreditation-card {
    position: relative;
    width: 100%;
    max-width: 380px;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.7), 0 0 40px rgba(231, 111, 81, 0.15);
    transition: transform 0.3s var(--ease-out), box-shadow 0.3s var(--ease-out);
  }

  .accreditation-card:hover {
    box-shadow: 0 32px 70px rgba(0, 0, 0, 0.85), 0 0 55px rgba(231, 111, 81, 0.3);
  }

  .card-image-wrap {
    position: relative;
    aspect-ratio: 4 / 5;
    background: var(--color-surface);
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    filter: contrast(1.08) brightness(1.02);
    transition: transform 0.5s var(--ease-out);
  }

  .accreditation-card:hover .card-img {
    transform: scale(1.04);
  }

  .card-overlay-badge {
    position: absolute;
    bottom: var(--space-xs);
    left: var(--space-xs);
    right: var(--space-xs);
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-2xs) var(--space-xs);
    border-radius: 8px;
    background: rgba(7, 9, 14, 0.65);
    backdrop-filter: blur(12px) saturate(180%);
    -webkit-backdrop-filter: blur(12px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-top-color: rgba(255, 255, 255, 0.25);
    box-shadow: inset 0 1px 1px 0 rgba(255, 255, 255, 0.15);
    font-family: var(--font-mono);
    font-size: var(--step--2);
  }

  .badge-match {
    color: var(--color-text);
  }

</style>
