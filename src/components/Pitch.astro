---
import { Image } from 'astro:assets';
import { social, thumb } from '../lib/social.js';
import { compactCount, longDate } from '../lib/format.js';
import { videoTag } from '../lib/video-tags.js';
import { Play, Eye, Flame, ExternalLink, X } from 'lucide-astro';

const topVideos = [...social.videos]
  .sort((a, b) => b.views - a.views)
  .slice(0, 6);
---
<div class="pitch-container">
  <header class="pitch-header">
    <div class="header-left">
      <p class="kicker reveal-text">
        <span class="hud-pill neon"><Flame class="icon-tiny" /> YOUTUBE</span>
      </p>
      <h2 class="pitch-title reveal-text">UNFILTERED INTEL.</h2>
      <p class="pitch-subtitle reveal-text">
        The most-watched Spin &amp; Swing videos on YouTube, ranked by views.
      </p>
    </div>
    <div class="header-right">
      <a class="channel-btn magnetic" href="https://www.youtube.com/@spinandswing26" target="_blank" rel="noopener" data-cursor-text="YOUTUBE">
        <span>Open channel</span>
        <ExternalLink class="icon-tiny" />
      </a>
    </div>
  </header>

  <!-- Video Grid Matrix with Smooth Horizontal Carousel on Touch / Grid on Desktop -->
  <div class="carousel-wrapper">
    <div class="video-grid" role="list">
      {topVideos.map((v, i) => (
        <article class="video-card tilt-card tilt-pop" role="listitem" data-cursor-text="PLAY">
          <div class="card-media">
            <a 
              class="video-link" 
              href={`https://www.youtube.com/watch?v=${v.id}`} 
              data-yt={v.id} 
              data-title={v.title}
              aria-label={`Play video: ${v.title}`}
            >
              <Image 
                class="video-thumb" 
                src={thumb(v.thumb)} 
                alt={v.title} 
                widths={[400, 720]} 
                sizes="(min-width: 64rem) 360px, 85vw" 
              />
              <div class="thumb-overlay"></div>
              <span class="play-trigger" aria-hidden="true">
                <Play class="play-icon" />
              </span>
            </a>

            <!-- Badge Overlays -->
            <div class="media-badges">
              <span class={`badge-tag ${videoTag(v.title, i).badgeClass}`}>
                {videoTag(v.title, i).tag}
              </span>
              <span class="views-pill">
                <Eye class="icon-micro" />
                {compactCount(v.views)}
              </span>
            </div>
          </div>

          <div class="card-body">
            <div class="meta-row">
              <span class="pub-date">{longDate(v.publishedAt)}</span>
            </div>
            <h3 class="video-heading">
              <a href={`https://www.youtube.com/watch?v=${v.id}`} target="_blank" rel="noopener">
                {v.title}
              </a>
            </h3>
          </div>
        </article>
      ))}
    </div>
  </div>

  <!-- Video Cinema Lightbox Modal -->
  <dialog class="video-modal" id="video-modal" aria-label="Video Player">
    <div class="modal-box">
      <div class="modal-header">
        <h3 class="modal-title" id="modal-video-title">Matchday Intel</h3>
        <button class="modal-close-btn" type="button" aria-label="Close video player" data-cursor-text="CLOSE">
          <X class="icon-close" />
        </button>
      </div>
      <div class="modal-media-frame" id="modal-iframe-slot">
        <!-- YouTube iframe dynamically injected on open, removed on close -->
      </div>
    </div>
  </dialog>
</div>

<script>
  // High-Impact Video Lightbox Modal (prevents scroll lock and cursor trapping)
  const modal = document.getElementById('video-modal') as HTMLDialogElement | null;
  const iframeSlot = document.getElementById('modal-iframe-slot');
  const modalTitle = document.getElementById('modal-video-title');
  const closeBtn = modal?.querySelector('.modal-close-btn');

  function openModal(ytId: string, title: string) {
    if (!modal || !iframeSlot) return;
    if (modalTitle) modalTitle.textContent = title;
    iframeSlot.innerHTML = `<iframe 
      src="https://www.youtube-nocookie.com/embed/${ytId}?autoplay=1&playsinline=1&rel=0" 
      title="${title}" 
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen" 
      allowfullscreen 
      class="player-embed modal-iframe"
    ></iframe>`;

    if (typeof modal.showModal === 'function') {
      modal.showModal();
    } else {
      modal.setAttribute('open', '');
    }
    const lenis = (window as unknown as { __lenis?: { stop: () => void } }).__lenis;
    if (lenis) lenis.stop();
  }

  function closeModal() {
    if (!modal || !iframeSlot) return;
    if (typeof modal.close === 'function') {
      modal.close();
    } else {
      modal.removeAttribute('open');
    }
    iframeSlot.innerHTML = '';
    const lenis = (window as unknown as { __lenis?: { start: () => void } }).__lenis;
    if (lenis) lenis.start();
  }

  document.querySelectorAll('a[data-yt]').forEach((link) => {
    link.addEventListener('click', (event) => {
      event.preventDefault();
      const ytId = (link as HTMLElement).dataset.yt;
      const title = (link as HTMLElement).dataset.title || 'YouTube video';
      if (ytId) openModal(ytId, title);
    });
  });

  closeBtn?.addEventListener('click', closeModal);

  modal?.addEventListener('click', (event) => {
    if (event.target === modal) {
      closeModal();
    }
  });

  modal?.addEventListener('close', () => {
    if (iframeSlot) iframeSlot.innerHTML = '';
    const lenis = (window as unknown as { __lenis?: { start: () => void } }).__lenis;
    if (lenis) lenis.start();
  });

  modal?.addEventListener('cancel', (event) => {
    event.preventDefault();
    closeModal();
  });
</script>

<style>
  .pitch-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-l);
    width: 100%;
    max-width: 86rem;
    margin: 0 auto;
  }

  .pitch-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: var(--space-m);
    padding-bottom: var(--space-s);
    border-bottom: 1px solid var(--color-line);
  }

  .header-left {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    max-width: 54ch;
  }

  .pitch-title {
    font-size: clamp(2.5rem, 6vw, 5.5rem);
    color: var(--color-text);
  }

  .pitch-subtitle {
    margin: 0;
    font-size: var(--step-0);
    color: var(--color-muted);
    line-height: 1.5;
  }

  .channel-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-xs) var(--space-m);
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-top-color: rgba(255, 255, 255, 0.32);
    background: var(--glass-bg);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    border: var(--glass-border);
    border-top-color: var(--glass-border-top);
    box-shadow: var(--glass-highlight), 0 8px 24px rgba(0, 0, 0, 0.35);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text);
    transition: all 0.25s var(--ease-out);
  }

  .channel-btn:hover {
    border-color: var(--color-neon);
    border-top-color: rgba(255, 140, 120, 0.6);
    color: var(--color-neon);
    background: var(--glass-bg-hover);
    box-shadow: var(--glass-highlight-hover), 0 0 24px rgba(231, 111, 81, 0.3);
  }

  .carousel-wrapper {
    width: 100%;
    overflow: visible;
  }

  @media (max-width: 48rem) {
    .carousel-wrapper {
      overflow-x: auto;
      overscroll-behavior-x: contain;
      padding-block: var(--space-m);
      margin-block: calc(-1 * var(--space-m));
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      scroll-snap-type: x mandatory;
      padding-inline: var(--space-s);
    }
  }

  .carousel-wrapper::-webkit-scrollbar {
    display: none;
  }

  .video-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: var(--space-l);
    width: 100%;
  }

  @media (max-width: 48rem) {
    .video-grid {
      display: flex;
      width: max-content;
      gap: var(--space-m);
      padding-right: var(--space-m);
    }
  }

  .video-card {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    background: var(--glass-bg);
    border: var(--glass-border);
    border-top-color: var(--glass-border-top);
    border-left-color: var(--glass-border-left);
    border-bottom-color: var(--glass-border-bottom);
    border-radius: var(--glass-radius);
    padding: var(--space-xs);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    box-shadow: var(--glass-highlight), 0 16px 40px -10px rgba(0, 0, 0, 0.65);
    transition: transform 0.3s var(--ease-out), border-color 0.3s var(--ease-out), box-shadow 0.3s var(--ease-out), background 0.3s var(--ease-out);
  }

  @media (max-width: 48rem) {
    .video-card {
      width: clamp(260px, 78vw, 340px);
      flex: 0 0 auto;
      scroll-snap-align: start;
    }
  }

  .video-card:hover {
    position: relative;
    z-index: 50;
    border-color: var(--color-neon);
    border-top-color: rgba(255, 140, 120, 0.6);
    background: var(--glass-bg-hover);
    box-shadow: var(--glass-highlight-hover), 0 24px 50px rgba(0, 0, 0, 0.8), 0 0 36px rgba(231, 111, 81, 0.4);
    /* transform (the actual "pop out" scale) is driven by initTiltCards()'s
       GSAP tween on this .tilt-pop card, not CSS -- see interactions.js */
  }

  .card-media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 8px;
    overflow: hidden;
    background: var(--color-surface);
  }

  .video-link {
    display: block;
    width: 100%;
    height: 100%;
    position: relative;
  }

  .video-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: contrast(1.08) brightness(0.95);
    transition: transform 0.6s var(--ease-out), filter 0.4s ease;
  }

  .video-card:hover .video-thumb {
    filter: contrast(1.15) brightness(1.05);
  }

  .thumb-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(7, 9, 14, 0.85) 0%, transparent 60%);
    pointer-events: none;
  }

  .play-trigger {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(0.9);
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    background: rgba(7, 9, 14, 0.85);
    border: 1px solid var(--color-neon);
    color: var(--color-neon);
    display: grid;
    place-items: center;
    box-shadow: 0 0 20px rgba(231, 111, 81, 0.4);
    transition: transform 0.3s var(--ease-out), background 0.3s ease, color 0.3s ease;
  }

  .video-card:hover .play-trigger {
    transform: translate(-50%, -50%) scale(1.1);
    background: var(--gradient-neon);
    color: var(--color-bg);
  }

  .play-icon {
    width: 1.25rem;
    height: 1.25rem;
    margin-left: 2px;
  }

  .media-badges {
    position: absolute;
    top: var(--space-xs);
    left: var(--space-xs);
    right: var(--space-xs);
    display: flex;
    justify-content: space-between;
    align-items: center;
    pointer-events: none;
  }

  .badge-tag {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 700;
    letter-spacing: 0.08em;
    padding: var(--space-3xs) var(--space-xs);
    border-radius: 6px;
    background: rgba(7, 9, 14, 0.65);
    backdrop-filter: blur(12px) saturate(180%);
    -webkit-backdrop-filter: blur(12px) saturate(180%);
    border: 1px solid;
    box-shadow: inset 0 1px 1px 0 rgba(255, 255, 255, 0.2);
  }

  .badge-tag.neon {
    color: var(--color-neon);
    border-color: rgba(231, 111, 81, 0.5);
  }

  .badge-tag.cyan {
    color: var(--color-cyan);
    border-color: rgba(42, 157, 143, 0.5);
  }

  .badge-tag.gold {
    color: var(--color-gold);
    border-color: rgba(233, 196, 106, 0.5);
  }

  .views-pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3xs);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 600;
    color: #FFF;
    background: rgba(7, 9, 14, 0.65);
    backdrop-filter: blur(12px) saturate(180%);
    -webkit-backdrop-filter: blur(12px) saturate(180%);
    padding: var(--space-3xs) var(--space-xs);
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-top-color: rgba(255, 255, 255, 0.25);
    box-shadow: inset 0 1px 1px 0 rgba(255, 255, 255, 0.15);
  }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding: var(--space-2xs);
  }

  .meta-row {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    font-family: var(--font-mono);
    font-size: var(--step--2);
  }

  .pub-date {
    color: var(--color-muted);
  }

  .video-heading {
    font-family: var(--font-body);
    font-size: var(--step-0);
    font-weight: 600;
    line-height: 1.35;
    text-transform: none;
    letter-spacing: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .video-heading a:hover {
    color: var(--color-neon);
  }

  /* Video Cinema Lightbox Modal */
  .video-modal {
    margin: auto;
    padding: 0;
    border: 1px solid var(--color-line-bright);
    border-radius: 16px;
    background: rgba(13, 16, 24, 0.96);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    box-shadow: 0 32px 80px rgba(0, 0, 0, 0.9), 0 0 50px rgba(231, 111, 81, 0.25);
    width: min(92vw, 56rem);
    max-width: 56rem;
    overflow: hidden;
    color: var(--color-text);
  }

  .video-modal::backdrop {
    background: rgba(7, 9, 14, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .modal-box {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-s) var(--space-m);
    border-bottom: 1px solid var(--color-line);
    gap: var(--space-s);
  }

  .modal-title {
    font-family: var(--font-body);
    font-size: var(--step-0);
    font-weight: 600;
    color: var(--color-text);
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .modal-close-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid var(--color-line);
    color: var(--color-text);
    cursor: pointer;
    transition: all 0.2s var(--ease-out);
    flex-shrink: 0;
  }

  .modal-close-btn:hover {
    background: rgba(231, 111, 81, 0.2);
    border-color: var(--color-neon);
    color: var(--color-neon);
    transform: scale(1.05);
  }

  .modal-media-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #000;
  }

  :global(.player-embed),
  :global(.modal-iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .icon-close {
    width: 1.25rem;
    height: 1.25rem;
  }

  .icon-tiny {
    width: 0.85rem;
    height: 0.85rem;
  }

  .icon-micro {
    width: 0.75rem;
    height: 0.75rem;
    color: var(--color-cyan);
  }
</style>
