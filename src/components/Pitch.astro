---
import { Image } from 'astro:assets';
import { social, thumb } from '../lib/social.js';
import { compactCount, longDate } from '../lib/format.js';
import { videoTag } from '../lib/video-tags.js';
import { Play, Eye, Sparkles, Flame, Trophy, ExternalLink } from 'lucide-astro';

// Sort videos strictly by views descending to surface the most viral hits first
const topVideos = [...social.videos]
  .sort((a, b) => b.views - a.views)
  .slice(0, 6);
---
<div class="pitch-container">
  <header class="pitch-header">
    <div class="header-left">
      <p class="kicker reveal-text">
        <span class="hud-pill neon"><Flame class="icon-tiny" /> VIRAL ARCHIVE</span>
        THE PITCH // MATCHDAY HIGHLIGHTS
      </p>
      <h2 class="pitch-title reveal-text">UNFILTERED INTEL.</h2>
      <p class="pitch-subtitle reveal-text">
        The most viewed cricket breakdowns, player feature stories, and matchday tactical analyses.
      </p>
    </div>
    <div class="header-right">
      <a class="channel-btn magnetic" href="https://www.youtube.com/@spinandswing26" target="_blank" rel="noopener" data-cursor-text="YOUTUBE">
        <span>Channel Archive</span>
        <ExternalLink class="icon-tiny" />
      </a>
    </div>
  </header>

  <!-- Video Grid Matrix with Smooth Horizontal Carousel on Touch / Grid on Desktop -->
  <div class="carousel-wrapper" data-lenis-prevent>
    <div class="video-grid" role="list">
      {topVideos.map((v, i) => (
        <article class="video-card tilt-card tilt-pop" role="listitem" data-cursor-text="PLAY">
          <div class="card-media">
            <a 
              class="video-link magnetic" 
              href={`https://www.youtube.com/watch?v=${v.id}`} 
              data-yt={v.id} 
              data-title={v.title}
              aria-label={`Play video: ${v.title}`}
            >
              <Image 
                class="video-thumb" 
                src={thumb(v.thumb)} 
                alt={v.title} 
                widths={[400, 720]} 
                sizes="(min-width: 64rem) 360px, 85vw" 
              />
              <div class="thumb-overlay"></div>
              <span class="play-trigger" aria-hidden="true">
                <Play class="play-icon" />
              </span>
            </a>

            <!-- Badge Overlays -->
            <div class="media-badges">
              <span class={`badge-tag ${videoTag(v.title, i).badgeClass}`}>
                {videoTag(v.title, i).tag}
              </span>
              <span class="views-pill">
                <Eye class="icon-micro" />
                {compactCount(v.views)}
              </span>
            </div>
          </div>

          <div class="card-body">
            <div class="meta-row">
              <span class="index-num">#{i + 1 < 10 ? `0${i + 1}` : i + 1}</span>
              <span class="pub-date">{longDate(v.publishedAt)}</span>
            </div>
            <h3 class="video-heading">
              <a href={`https://www.youtube.com/watch?v=${v.id}`} target="_blank" rel="noopener">
                {v.title}
              </a>
            </h3>
          </div>
        </article>
      ))}
    </div>
  </div>
</div>

<script>
  // Instant YouTube Player Injection
  document.querySelectorAll('a[data-yt]').forEach((link) => {
    link.addEventListener('click', (event) => {
      event.preventDefault();
      const ytId = (link as HTMLElement).dataset.yt;
      const title = (link as HTMLElement).dataset.title || 'YouTube video';
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${ytId}?autoplay=1&playsinline=1&rel=0`;
      iframe.title = title;
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      iframe.allowFullscreen = true;
      iframe.className = 'player-embed';
      link.parentElement?.replaceChild(iframe, link);
      iframe.focus();
    });
  });
</script>

<style>
  .pitch-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-l);
    width: 100%;
    max-width: 86rem;
    margin: 0 auto;
  }

  .pitch-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: var(--space-m);
    padding-bottom: var(--space-s);
    border-bottom: 1px solid var(--color-line);
  }

  .header-left {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    max-width: 54ch;
  }

  .pitch-title {
    font-size: clamp(2.5rem, 6vw, 5.5rem);
    color: var(--color-text);
  }

  .pitch-subtitle {
    margin: 0;
    font-size: var(--step-0);
    color: var(--color-muted);
    line-height: 1.5;
  }

  .channel-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-xs) var(--space-m);
    border-radius: 9999px;
    border: 1px solid var(--color-line-bright);
    background: rgba(17, 20, 29, 0.75);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text);
    transition: all 0.25s var(--ease-out);
  }

  .channel-btn:hover {
    border-color: var(--color-neon);
    color: var(--color-neon);
    background: rgba(231, 111, 81, 0.1);
  }

  .carousel-wrapper {
    width: 100%;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    padding-bottom: var(--space-m);
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x mandatory;
    padding-inline: 4px;
  }

  .carousel-wrapper::-webkit-scrollbar {
    display: none;
  }

  .video-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: var(--space-m);
    width: 100%;
  }

  @media (max-width: 48rem) {
    .video-grid {
      display: flex;
      width: max-content;
      gap: var(--space-m);
      padding-right: var(--space-m);
    }
  }

  .video-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    background: var(--color-card);
    border: 1px solid var(--color-line);
    border-radius: 12px;
    padding: var(--space-xs);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition: transform 0.3s var(--ease-out), border-color 0.3s var(--ease-out), box-shadow 0.3s var(--ease-out);
  }

  @media (max-width: 48rem) {
    .video-card {
      width: clamp(260px, 78vw, 340px);
      flex: 0 0 auto;
      scroll-snap-align: start;
    }
  }

  .video-card:hover {
    position: relative;
    z-index: 2;
    border-color: var(--color-blood);
    box-shadow: 0 24px 50px rgba(0, 0, 0, 0.75), 0 0 32px rgba(141, 8, 1, 0.5);
    /* transform (the actual "pop out" scale) is driven by initTiltCards()'s
       GSAP tween on this .tilt-pop card, not CSS -- see interactions.js */
  }

  .card-media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 8px;
    overflow: hidden;
    background: var(--color-surface);
  }

  .video-link {
    display: block;
    width: 100%;
    height: 100%;
    position: relative;
  }

  .video-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: contrast(1.08) brightness(0.95);
    transition: transform 0.6s var(--ease-out), filter 0.4s ease;
  }

  .video-card:hover .video-thumb {
    filter: contrast(1.15) brightness(1.05);
  }

  .thumb-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(7, 9, 14, 0.85) 0%, transparent 60%);
    pointer-events: none;
  }

  .play-trigger {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(0.9);
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    background: rgba(7, 9, 14, 0.85);
    border: 1px solid var(--color-neon);
    color: var(--color-neon);
    display: grid;
    place-items: center;
    box-shadow: 0 0 20px rgba(231, 111, 81, 0.4);
    transition: transform 0.3s var(--ease-out), background 0.3s ease, color 0.3s ease;
  }

  .video-card:hover .play-trigger {
    transform: translate(-50%, -50%) scale(1.1);
    background: var(--gradient-neon);
    color: var(--color-bg);
  }

  .play-icon {
    width: 1.25rem;
    height: 1.25rem;
    margin-left: 2px;
  }

  .media-badges {
    position: absolute;
    top: var(--space-xs);
    left: var(--space-xs);
    right: var(--space-xs);
    display: flex;
    justify-content: space-between;
    align-items: center;
    pointer-events: none;
  }

  .badge-tag {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 700;
    letter-spacing: 0.08em;
    padding: var(--space-3xs) var(--space-xs);
    border-radius: 4px;
    background: rgba(7, 9, 14, 0.85);
    backdrop-filter: blur(8px);
    border: 1px solid;
  }

  .badge-tag.neon {
    color: var(--color-neon);
    border-color: rgba(231, 111, 81, 0.4);
  }

  .badge-tag.cyan {
    color: var(--color-cyan);
    border-color: rgba(42, 157, 143, 0.4);
  }

  .badge-tag.gold {
    color: var(--color-gold);
    border-color: rgba(233, 196, 106, 0.4);
  }

  .views-pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3xs);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 600;
    color: #FFF;
    background: rgba(7, 9, 14, 0.85);
    padding: var(--space-3xs) var(--space-xs);
    border-radius: 4px;
    border: 1px solid var(--color-line);
  }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding: var(--space-2xs);
  }

  .meta-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-mono);
    font-size: var(--step--2);
  }

  .index-num {
    color: var(--color-neon);
    font-weight: 700;
  }

  .pub-date {
    color: var(--color-muted);
  }

  .video-heading {
    font-family: var(--font-body);
    font-size: var(--step-0);
    font-weight: 600;
    line-height: 1.35;
    text-transform: none;
    letter-spacing: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .video-heading a:hover {
    color: var(--color-neon);
  }

  :global(.player-embed) {
    width: 100%;
    height: 100%;
    border: none;
    border-radius: 8px;
  }

  .icon-tiny {
    width: 0.85rem;
    height: 0.85rem;
  }

  .icon-micro {
    width: 0.75rem;
    height: 0.75rem;
    color: var(--color-cyan);
  }
</style>
