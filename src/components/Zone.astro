---
import { Image } from 'astro:assets';

interface Props {
  id: string;
  label: string;
  still: ImageMetadata;
  eager?: boolean;
}
const { id, label, still, eager = false } = Astro.props;
---
<section id={id} class="zone" aria-label={label} data-zone={id}>
  <Image
    class="zone-still"
    src={still}
    alt=""
    widths={[720, 1280, 1920, 2560]}
    sizes="100vw"
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
  />
  <div class="zone-content"><slot /></div>
</section>

<style>
  .zone {
    position: relative;
    min-height: 100dvh;
    display: grid;
  }
  .zone-still,
  .zone-content {
    grid-area: 1 / 1;
  }
  .zone-still {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .zone-content {
    position: relative;
    z-index: 1;
    align-self: center;
    padding: 1.5rem;
  }
  :global(html.scrub-on) .zone-still {
    visibility: hidden;
  }
</style>
