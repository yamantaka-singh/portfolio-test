---
import { Image } from 'astro:assets';

interface Props {
  id: string;
  label: string;
  still: ImageMetadata;
  eager?: boolean;
  position?: string;
}
const { id, label, still, eager = false, position = 'center' } = Astro.props;
---
<section id={id} class="zone" aria-label={label} data-zone={id}>
  <Image
    class="zone-still"
    src={still}
    alt=""
    widths={[720, 1280, 1920, 2560]}
    sizes="100vw"
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    style={`object-position: ${position};`}
  />
  <div class="zone-content"><slot /></div>
</section>

<style>
  .zone {
    position: relative;
    min-height: 100dvh;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr);
    width: 100%;
    overflow: hidden;
  }
  .zone-still,
  .zone-content,
  .zone::after {
    grid-area: 1 / 1;
  }
  .zone-still {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.55) contrast(1.18) saturate(1.05);
  }
  .zone::after {
    content: '';
    z-index: 1;
    pointer-events: none;
    background: 
      radial-gradient(circle at center, rgba(7, 9, 14, 0.4) 0%, rgba(7, 9, 14, 0.88) 100%),
      linear-gradient(to bottom, var(--color-bg) 0%, transparent 12%, transparent 85%, var(--color-bg) 100%);
  }
  .zone-content {
    position: relative;
    z-index: 2;
    align-self: center;
    width: min(100%, 86rem);
    margin-inline: auto;
    padding: clamp(var(--space-l), 5vw, var(--space-2xl)) clamp(var(--space-s), 3.5vw, var(--space-xl));
    padding-bottom: clamp(4.5rem, 10vw, 7rem); /* Safe space for BroadcastDock */
  }

  @media (max-width: 48rem) {
    .zone-content {
      padding: var(--space-m) clamp(0.75rem, 3vw, var(--space-m));
      padding-bottom: clamp(4rem, 9vw, 5.5rem);
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .zone-content > :global(*) {
        animation: zone-rise linear both;
        animation-timeline: view();
        animation-range: entry 5% cover 30%;
      }
    }
  }
  @keyframes zone-rise {
    from {
      opacity: 0;
      transform: translateY(2rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
